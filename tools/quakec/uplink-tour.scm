; Stock IPX test fixture. Only the co-op verifier compiles and spawns it.
(import "../../examples/map-boot.scm")

(define-field tour-command)
(define-field tour-player)
(define-field tour-bike)
(define-field tour-roof)

(define (uplink_tour_stop) 0)

(define (uplink_tour_driver)
  (quake:set-callback! (quake:self) think uplink-tour-tick)
  (quake:set-field! (quake:self) nextthink (+ (quake:time) 0.05)))

(define (uplink-tour-stop cursor command slot)
  (let ((stop (quake:find cursor classname "uplink_tour_stop")))
    (cond
      ((quake:world? stop) stop)
      ((and (= (quake:field stop tour-command) command)
            (= (quake:field stop tour-player) slot)) stop)
      (else (uplink-tour-stop stop command slot)))))

(define (uplink-tour-bike player stop)
  (let ((bike (uplink-free-bike player (quake:world) (quake:world))))
    (when (not (quake:world? bike))
      (quake:set-field! bike angles (quake:field stop angles))
      (quake:set-origin bike (quake:vector (- (quake:field stop origin_x) 72)
                                           (quake:field stop origin_y)
                                           (quake:field stop origin_z)))
      (park-bike bike))))

(define (uplink-tour-move player stop command slot)
  (let* ((yaw (quake:field stop angles_y))
         (bikes (quake:field stop tour-bike)))
    (when (or (= (quake:field stop tour-roof) 0) (> (quake:field player origin_z) 3850))
      (when (not (= bikes 2)) (return-bike player))
      (when (= bikes 1) (uplink-tour-bike player stop))
      (quake:set-field! player velocity (quake:vector 0 0 0))
      (quake:set-field! player bike-vx 0)
      (quake:set-field! player bike-vy 0)
      (quake:set-field! player angles (quake:field stop angles))
      (quake:set-field! player bike-heading (bike-wrap-angle yaw))
      (quake:set-field! player bike-steer-yaw (bike-wrap-angle yaw))
      (quake:set-field! player bike-view-yaw (bike-wrap-angle yaw))
      (quake:set-field! player bike-prior-view-yaw (bike-wrap-angle yaw))
      (quake:set-field! player bike-camera-yaw (bike-wrap-angle yaw))
      (quake:set-origin player (quake:field stop origin))
      (quake:set-view-angles! player 0 yaw 0)
      (trace-numbers "tour" command slot))))

(define (uplink-tour-visit cursor)
  (let ((player (quake:find cursor classname "qslisp_player")))
    (when (not (quake:world? player))
      (let ((command (quake:field player impulse)) (slot (quake:field player colormap)))
        (when (and (active-player? player) (>= command 50) (<= command 56))
          (quake:set-field! player impulse 0)
          (let ((stop (uplink-tour-stop (quake:world) command slot)))
            (when (not (quake:world? stop)) (uplink-tour-move player stop command slot)))))
      (uplink-tour-visit player))))

(define (uplink-tour-tick)
  (quake:set-field! (quake:self) nextthink (+ (quake:time) 0.05))
  (uplink-tour-visit (quake:world)))
