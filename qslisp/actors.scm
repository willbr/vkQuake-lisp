; Stock-engine actor and sequence declarations.
;
; Restarts, after Common Lisp's condition system. Stock Quake cannot unwind
; and its error builtin ends the server, so (signal-actor actor message)
; parks the actor instead: its think stops and every player is offered
; restarts. Keys 8, 9, and 0 send impulses 26-28; the parked actor's use
; callback, generated by define-actor's restart clause, retries the state,
; runs the skip action first, or removes the actor.
(define-field actor-parked string)
(define-field actor-condition string)
(define-field actor-choice)

(define (signal-actor actor message)
  (quake:set-field! actor actor-parked "parked")
  (quake:set-field! actor actor-condition message)
  ; A level can signal before anyone has connected, so a parked actor's
  ; think only repeats its condition and the restart keys.
  (quake:set-callback! actor think actor-remind)
  (quake:set-field! actor nextthink (+ (quake:time) 0.1))
  (quake:dprint "actor: condition signaled\n"))

(define (actor-remind)
  (let ((actor (quake:self)))
    (quake:bprint (quake:field actor actor-condition))
    (quake:bprint "Restarts: 8 retry, 9 skip, 0 abort.\n")
    (quake:set-field! actor nextthink (+ (quake:time) 2))))

(define (actor-restart-input player)
  (let ((command (quake:field player impulse)))
    (when (and (>= command 26) (<= command 28))
      (quake:set-field! player impulse 0)
      (let ((actor (quake:find (quake:world) actor-parked "parked")))
        (if (quake:world? actor)
            (quake:centerprint player "No actor is waiting for a restart.")
            (begin
              (quake:set-field! actor actor-choice (- command 25))
              (quake:call-callback actor use player)))))))

(define-syntax define-actor
  (syntax-rules (spawn context states restart)
    ((define-actor classname tick actor state-field interval
        (spawn initial)
        (context binding ...)
        (states (state action) ...)
        (restart restart-name retry-action skip-action))
     (begin
       (define-actor classname tick actor state-field interval
         (spawn (begin initial (quake:set-callback! actor use restart-name)))
         (context binding ...)
         (states (state action) ...))
       (define (restart-name)
         (let* ((actor (quake:self)) (choice (quake:field actor actor-choice)))
           (quake:set-field! actor actor-parked "")
           (cond
             ((= choice 3)
              (quake:dprint "actor: restart abort\n")
              (quake:remove actor))
             (else
              (when (= choice 2) (quake:dprint "actor: restart skip\n") skip-action)
              (when (= choice 1) (quake:dprint "actor: restart retry\n") retry-action)
              (quake:set-callback! actor think tick)
              (quake:set-field! actor nextthink (+ (quake:time) interval))))))))
    ((define-actor classname tick actor state-field interval
        (spawn initial)
        (context binding ...)
        (states (state action) ...))
     (begin
       (define (classname)
         (let ((actor (quake:self)))
           initial
           (quake:set-callback! actor think tick)
           (quake:set-field! actor nextthink (+ (quake:time) interval))))
       (define (tick)
         (let* ((actor (quake:self)) binding ...)
           (quake:set-field! actor nextthink (+ (quake:time) interval))
           (cond ((= (quake:field actor state-field) state) action) ...)))))))

(define-syntax define-sequence
  (syntax-rules (step)
    ((define-sequence (step name action ...) ...)
     (begin (define (name) action ...) ...))))

(define-syntax after
  (syntax-rules ()
    ((after duration callback)
     (let* ((subject (quake:self))
            (clock (if (= (quake:field subject movetype) 7)
                       (quake:field subject ltime)
                       (quake:time))))
       (quake:set-callback! subject think callback)
       (quake:set-field! subject nextthink (+ clock duration))))))
