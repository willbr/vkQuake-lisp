; Map-authored supplies, checkpoints, and weapon selection.
(define-field checkpoint entity)
(define-field switch-used)
(define-field next-level string)
(define (set-pickup-model item model)
  (quake:set-field! item solid solid-trigger)
  (quake:set-model item model)
  (quake:set-size item (quake:vector -14 -14 -18) (quake:vector 14 14 20)))

(define (qslisp_health)
  (quake:precache-model "maps/b_bh25.bsp")
  (set-pickup-model (quake:self) "maps/b_bh25.bsp")
  (quake:set-callback! (quake:self) touch collect-health))

(define (qslisp_ammo)
  (quake:precache-model "maps/b_shell0.bsp")
  (set-pickup-model (quake:self) "maps/b_shell0.bsp")
  (quake:set-callback! (quake:self) touch collect-shells))

(define (qslisp_pulse)
  (quake:precache-model "progs/g_nail.mdl")
  (set-pickup-model (quake:self) "progs/g_nail.mdl")
  (quake:set-callback! (quake:self) touch collect-pulse))

(define (active-player? other)
  (and (player-entity? other) (> (quake:field other health) 0)))

(define (collect-health)
  (let* ((player (quake:other)) (health (quake:field player health)))
    (when (and (active-player? player) (< health 100))
      (quake:set-field! player health (if (> health 75) 100 (+ health 25)))
      (quake:remove (quake:self))
      (quake:sound player 2 "items/health1.wav" 1 1)
      (quake:centerprint player "Health restored.")
      (quake:dprint "qslisp: health collected\n"))))

(define (collect-shells)
  (let ((player (quake:other)))
    (when (active-player? player)
      (quake:set-field! player ammo_shells (+ (quake:field player ammo_shells) 3))
      (quake:set-field! player currentammo (weapon-ammo player))
      (quake:remove (quake:self))
      (quake:sound player 2 "weapons/pkup.wav" 1 1)
      (quake:centerprint player "Picked up 3 shells.")
      (quake:dprint "qslisp: shells collected\n"))))

(define (collect-pulse)
  (let ((player (quake:other)))
    (when (active-player? player)
      (quake:set-field! player items (quake:bit-or (quake:field player items) pulse-weapon))
      (quake:set-field! player ammo_nails (+ (quake:field player ammo_nails) 6))
      (quake:set-field! player currentammo (weapon-ammo player))
      (quake:remove (quake:self))
      (quake:sound player 2 "weapons/pkup.wav" 1 1)
      (quake:centerprint player "Pulse carbine acquired.\nPress 2 to equip it.")
      (quake:dprint "qslisp: pulse collected\n"))))

(define (qslisp_checkpoint)
  (let ((spot (quake:self)))
    (quake:set-field! spot solid solid-trigger)
    (quake:set-size spot (quake:vector -18 -18 -24) (quake:vector 18 18 26))
    (quake:set-callback! spot touch activate-checkpoint)))

(define (activate-checkpoint)
  (let ((player (quake:other)) (spot (quake:self)))
    (when (and (active-player? player)
               (not (quake:entity=? (quake:field player checkpoint) spot)))
      (quake:set-field! player checkpoint spot)
      (quake:centerprint player "Checkpoint reached.")
      (quake:dprint "qslisp: checkpoint reached\n"))))

(define (spawn-point player)
  (let* ((checkpoint (quake:field player checkpoint))
         (primary (quake:find (quake:world) classname "info_player_start")))
    (cond
      ((= (quake:coop) 0) (if (quake:world? checkpoint) primary checkpoint))
      ((and (not (quake:world? checkpoint)) (not (occupied-start? checkpoint player (quake:world))))
       checkpoint)
      ((and (= (quake:field player colormap) 1) (not (occupied-start? primary player (quake:world))))
       primary)
      (else (coop-start player (quake:world) primary)))))

(define (occupied-start? spot player cursor)
  (let ((other (quake:find cursor classname "qslisp_player")))
    (and (not (quake:world? other))
         (or (and (not (quake:entity=? player other)) (active-player? other)
                  (< (sentry-distance-squared spot other) 2304)
                  (< (- (quake:field spot origin_z) (quake:field other origin_z)) 56)
                  (< (- (quake:field other origin_z) (quake:field spot origin_z)) 56))
             (occupied-start? spot player other)))))

(define (coop-start player cursor primary)
  (let ((spot (quake:find cursor classname "info_player_coop")))
    (cond
      ((quake:world? spot) primary)
      ((occupied-start? spot player (quake:world)) (coop-start player spot primary))
      (else spot))))

(define (qslisp_switch)
  (let ((control (quake:self)))
    (quake:set-field! control movetype move-push)
    (quake:set-field! control solid solid-brush)
    (quake:set-model control (quake:field control model))
    (quake:set-callback! control use use-switch)))

(define (use-switch)
  (let* ((control (quake:self)) (player (quake:other)) (door (find-linked control)))
    (when (and (active-player? player)
               (not (quake:world? door))
               (= (quake:field control switch-used) 0))
      (quake:set-field! control switch-used 1)
      (quake:call-callback door use player)
      ; The used console clears the narrow service lane.
      (quake:set-field! control solid 0)
      (quake:set-field! control modelindex 0)
      (quake:set-origin control (quake:field control origin))
      (quake:sound player 2 "misc/medkey.wav" 1 1)
      (quake:centerprint player "Access switch activated.")
      (quake:dprint "qslisp: switch used\n"))))

(define (interact player)
  (when (= (quake:field player impulse) 10)
    (quake:set-field! player impulse 0)
    (cond
      ((riding-bike? player)
       (when (not (uplink-lift-input player)) (dismount-bike player)))
      ((= (quake:field player movetype) move-walk)
       (let* ((hit (aimed-entity player 96)) (class (quake:field hit classname)))
         (if (or (string=? class "qslisp_switch") (string=? class "qslisp_bike")
                 (string=? class "uplink_station") (string=? class "uplink_buddy")
                 (string=? class "uplink_recall"))
             (quake:call-callback hit use player)
             (let ((station (uplink-aimed-station player)))
               (if (quake:world? station)
                   (uplink-lift-input player)
                   (quake:call-callback station use player))))))
      ((string=? (quake:field player next-level) "annex")
       (quake:dprint "qslisp: changing to Relay Annex\n")
       (quake:change-level "annex")))))
