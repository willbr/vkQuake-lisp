; The stock player hull handles collisions. The bike owns planar momentum.
(define-field riding entity)
(define-field bike-rider entity)
(define-field bike-last-rider entity)
(define-field bike-heading)
(define-field bike-vx)
(define-field bike-vy)
(define-field bike-skidding)
(define-field bike-relay-active)
(define-field bike-camera entity)
(define-field bike-view entity)
(define-field bike-next-view)
(define-field bike-key-mode)
(define-field bike-next-keys)
(define-field bike-reverse-request)
(define-field bike-front-angle)
(define-field bike-slip)
(define-field bike-bank)
(define-field bike-pitch)
(define-field bike-camera-yaw)
(define-field bike-camera-floor)
(define-field bike-camera-reach)
(define-field bike-view-yaw)
(define-field bike-view-command-yaw)
(define-field bike-prior-view-yaw)
(define-field bike-angle-format)
(define-field bike-steer-yaw)
(define-field bike-next-dust)
(define-field bike-air-time)
(define-field bike-landing-dust-until)
(define-field bike-bank-contact)
(define-field bike-grade-x)
(define-field bike-grade-y)
(define-field bike-contact-grip)

(define bike-top-speed 408)
(define bike-reverse-speed 108)
(define bike-wheelbase 48)
(define bike-solid 2)
(define bike-chase-pitch 19)

(define (riding-bike? player)
  (not (quake:world? (quake:field player riding))))

(define (qslisp_bike)
  (quake:precache-model "progs/bike.mdl")
  (quake:precache-model "progs/r_bike.mdl")
  (quake:precache-model "progs/bikecam.mdl")
  (quake:precache-sound "misc/bikeskid.wav")
  (let ((bike (quake:self)))
    (park-bike bike)
    (quake:set-callback! bike use mount-bike)))

(define (park-bike bike)
  (quake:set-field! bike bike-rider (quake:world))
  (quake:set-model bike "progs/bike.mdl")
  (quake:set-field! bike solid bike-solid)
  (quake:make-vectors (quake:vector 0 (quake:field bike angles_y) 0))
  (let* ((fx (bike-abs (quake:forward-x)))
         (fy (bike-abs (quake:forward-y)))
         (x (+ (* 26 fx) (* 12 fy)))
         (y (+ (* 26 fy) (* 12 fx))))
    (quake:set-size bike (quake:vector (- x) (- y) -24) (quake:vector x y 30)))
  (quake:set-origin bike (quake:field bike origin)))

(define (mount-bike)
  (let ((bike (quake:self)) (player (quake:other)))
    (when (and (active-player? player) (not (riding-bike? player))
               (quake:world? (quake:field bike bike-rider)))
      (quake:set-field! bike bike-rider player)
      (quake:set-field! bike bike-last-rider player)
      (quake:set-field! bike solid 0)
      (quake:set-field! bike modelindex 0)
      (quake:set-origin bike (quake:field bike origin))
      (quake:set-field! player riding bike)
      (quake:set-field! player bike-heading (bike-wrap-angle (quake:field bike angles_y)))
      (quake:set-field! player bike-steer-yaw (quake:field player bike-heading))
      (quake:set-field! player bike-vx 0)
      (quake:set-field! player bike-vy 0)
      (quake:set-field! player bike-front-angle 0)
      (quake:set-field! player bike-contact-grip 1)
      (quake:set-field! player bike-slip 0)
      (quake:set-field! player bike-bank 0)
      (quake:set-field! player bike-pitch 0)
      (quake:set-field! player bike-bank-contact 0)
      (quake:set-field! player bike-next-dust 0)
      (quake:set-field! player bike-air-time 0)
      (quake:set-field! player bike-landing-dust-until 0)
      (quake:set-field! player bike-reverse-request 0)
      (quake:set-field! player bike-skidding 0)
      (quake:set-field! player velocity (quake:vector 0 0 0))
      (quake:set-field! player angles (quake:vector 0 (quake:field player bike-heading) 0))
      (quake:set-model player "progs/r_bike.mdl")
      (quake:set-size player (quake:vector -16 -16 -24) (quake:vector 16 16 32))
      (quake:set-origin player (quake:field bike origin))
      (quake:set-field! player weaponmodel "")
      (quake:set-field! player weaponframe 0)
      (quake:centerprint player "Up to pedal  Down to brake or back up\nLeft and Right to steer\nE to dismount when stopped")
      (quake:dprint "qslisp: bike mounted\n"))))

(define (clear-rider player)
  (let ((camera (quake:field player bike-camera)))
    (when (not (quake:world? camera))
      (quake:set-view player player)
      (quake:remove camera)
      (quake:set-field! player bike-camera (quake:world))
      (quake:set-field! player bike-view (quake:world))
      (quake:set-field! player bike-next-view 0)))
  (quake:set-field! player riding (quake:world))
  (quake:set-field! player bike-vx 0)
  (quake:set-field! player bike-vy 0)
  (quake:set-field! player bike-front-angle 0)
  (quake:set-field! player bike-slip 0)
  (quake:set-field! player bike-bank 0)
  (quake:set-field! player bike-bank-contact 0)
  (quake:set-field! player bike-reverse-request 0)
  (quake:set-field! player bike-skidding 0)
  (quake:set-field! player frame 0)
  (quake:set-field! player angles_z 0)
  (quake:set-field! player punchangle_y 0)
  (quake:set-model player "progs/player.mdl")
  (quake:set-size player (quake:vector -16 -16 -24) (quake:vector 16 16 32))
  (equip player (quake:field player weapon)))

(define (return-bike player)
  ; The hidden bike stays at its last parking spot while somebody rides it.
  (when (riding-bike? player)
    (park-bike (quake:field player riding))
    (clear-rider player)))

(define (bike-step-off player direction)
  (quake:make-vectors (quake:vector 0 direction 0))
  (let ((x (quake:field player origin_x))
        (y (quake:field player origin_y))
        (z (quake:field player origin_z)))
    ; The ground step tests its landing spot. Check the path first.
    (quake:traceline (quake:vector x y z)
                     (quake:vector (+ x (* 52 (quake:forward-x)))
                                   (+ y (* 52 (quake:forward-y))) z)
                     0 player)
    (and (= (quake:trace-fraction) 1) (> (quake:walkmove direction 52) 0))))

(define (dismount-bike player)
  (let ((bike (quake:field player riding))
        (x (quake:field player bike-vx))
        (y (quake:field player bike-vy))
        (heading (quake:field player bike-heading)))
    (if (> (+ (* x x) (* y y)) 1600)
        (quake:centerprint player "Brake before dismounting.")
        (let ((parking (quake:field player origin)))
          (if (or (bike-step-off player (+ heading 90))
                  (bike-step-off player (- heading 90))
                  (bike-step-off player (+ heading 180)))
              (begin
                (quake:set-origin bike parking)
                (quake:set-field! bike angles (quake:vector 0 heading 0))
                (park-bike bike)
                (clear-rider player)
                (quake:set-view-angles! player 0 heading 0)
                (quake:set-field! player velocity (quake:vector 0 0 0))
                (quake:set-field! player next-shot (+ (quake:time) 0.2))
                (quake:dprint "qslisp: bike dismounted\n"))
              (quake:centerprint player "Move away from the wall to dismount."))))))

(define (bike-clamp x lower upper)
  (cond ((< x lower) lower) ((> x upper) upper) (else x)))

(define (bike-wrap-angle yaw)
  (cond ((>= yaw 180) (- yaw 360)) ((< yaw -180) (+ yaw 360)) (else yaw)))

(define (bike-abs x)
  (if (< x 0) (- x) x))

(define (bike-wire-angle angle)
  ; NetQuake truncates to integer degrees before packing angles into bytes.
  (let* ((degrees (quake:floor (bike-abs angle)))
         (packed (* 1.40625 (quake:floor (/ (* degrees 256) 360)))))
    (if (< angle 0) (- packed) packed)))

(define (bike-view-reply yaw format)
  (cond
    ((= format 1)
     ; The original client wraps yaw to [0,360) and packs it a second time.
     (let ((received (bike-wire-angle yaw)))
       (bike-wrap-angle (bike-wire-angle (if (< received 0) (+ received 360) received)))))
    ((= format 2)
     (bike-wrap-angle (* 1.40625 (quake:floor (+ (/ yaw 1.40625) 0.5)))))
    (else yaw)))

(define (bike-steering-yaw player)
  (let* ((aim (quake:field player bike-steer-yaw))
         (heading (quake:field player bike-heading))
         (input (bike-wrap-angle (quake:field player v_angle_y)))
         (sent (quake:field player bike-view-yaw))
         (delta (bike-wrap-angle (- input sent))))
    ; The client applies its native key and mouse turns to the last camera yaw.
    ; A prior camera sample can still be in flight on a networked client.
    (cond
      ; A ride saved before chase steering has no input format or steering yaw.
      ((= (quake:field player bike-angle-format) 0)
       (set! aim heading))
      ((and (not (quake:world? (quake:field player bike-camera)))
            (or (= (quake:coop) 0)
                (> (bike-abs (bike-wrap-angle (- input (quake:field player bike-prior-view-yaw)))) 0.02))
            (> (bike-abs delta) 0.02)
            (< (bike-abs delta) 28))
       ; Limit how far input can lead the frame when the bike is blocked.
       (let ((lead (bike-wrap-angle (- aim heading))))
         (set! aim (bike-wrap-angle (+ heading (bike-clamp (+ lead delta) -55 55)))))))
    (quake:set-field! player bike-steer-yaw aim)
    aim))

(define (bike-approach current target step)
  (+ current (bike-clamp (- target current) (- step) step)))

(define (bike-sync-arrows player riding)
  (let* ((mode (if riding 2 1))
         (changed (not (= mode (quake:field player bike-key-mode)))))
    (when (or changed (>= (quake:time) (quake:field player bike-next-keys)))
      (when changed
        (if riding
            (quake:client-command player "-forward\n-back\n")
            (quake:client-command player "-attack 128\n-jump 129\n")))
      ; Keep the same physical key identifier in both halves of the Down alias.
      (if riding
          (quake:client-command player "alias +bikeback \"+jump 129; impulse 4\"\nalias -bikeback \"-jump 129; impulse 5\"\nbind UPARROW +attack\nbind DOWNARROW +bikeback\n")
          (quake:client-command player "bind UPARROW +forward\nbind DOWNARROW +back\n"))
      (quake:set-field! player bike-key-mode mode)
      ; A load or reconnect can restore the server state in a fresh client.
      (quake:set-field! player bike-next-keys (+ (quake:time) 1)))))

(define (bike-reverse-input player braking)
  (let ((impulse (quake:field player impulse)))
    (cond
      ((= impulse 4)
       (quake:set-field! player impulse 0)
       (quake:set-field! player bike-reverse-request 1))
      ((= impulse 5)
       (quake:set-field! player impulse 0)
       (quake:set-field! player bike-reverse-request 0)))
    (when (not braking)
      (quake:set-field! player bike-reverse-request 0))
    (and braking (= (quake:field player bike-reverse-request) 1))))

(define (bike-drive-speed speed dt pedal brake reverse braking-rate)
  (cond
    ((and brake (> speed 0)) (bike-approach speed 0 (* braking-rate dt)))
    ((and brake reverse) (bike-approach speed (- bike-reverse-speed) (* 225 dt)))
    (brake (bike-approach speed 0 (* 480 dt)))
    (pedal (bike-approach speed bike-top-speed (* 525 dt)))
    (else (bike-approach speed 0 (* 115 dt)))))

(define (bike-update-slip player speed braking dt)
  (let* ((previous (quake:field player bike-slip))
         (target (if braking (bike-clamp (/ (- speed 85) 115) 0 1) 0))
         (rate (if (> target previous) 11 2.6))
         (slip (bike-approach previous target (* rate dt))))
    (quake:set-field! player bike-slip slip)
    slip))

(define (qslisp_bike_bank)
  (let ((bank (quake:self)))
    (quake:set-field! bank movetype move-push)
    (quake:set-field! bank solid solid-brush)
    (quake:set-model bank (quake:field bank model))))

(define (bike-surface-pose player)
  (let ((x (quake:field player origin_x)) (y (quake:field player origin_y))
        (z (quake:field player origin_z)) (vz (quake:field player velocity_z)))
    (let* ((surface (quake:traceline (quake:vector x y z) (quake:vector x y (- z 48)) 1 player))
           (supported (> (quake:trace-normal-z) 0.7))
           (banked (and supported (string=? (quake:field surface classname) "qslisp_bike_bank")
                        (< (- z (quake:trace-end-z)) 44)))
           (grounded (and supported (or banked (> (quake:bit-and (quake:field player flags) flag-ground) 0))))
           (nx (quake:trace-normal-x))
           (ny (quake:trace-normal-y)))
      (quake:set-field! player bike-bank-contact (if banked 1 0))
      (when banked
        (quake:set-field! player bike-grade-x (/ (- nx) (quake:trace-normal-z)))
        (quake:set-field! player bike-grade-y (/ (- ny) (quake:trace-normal-z))))
      (quake:make-vectors (quake:vector 0 (quake:field player bike-heading) 0))
      (let* ((fx (quake:forward-x))
             (fy (quake:forward-y))
             (target (if grounded (* 62 (- (* nx fy) (* ny fx))) 0))
             (bank (bike-approach (quake:field player bike-bank) target (* 170 (quake:frametime))))
             (old-pitch (quake:field player bike-pitch))
             (target-pitch (bike-clamp (if grounded (* -62 (+ (* nx fx) (* ny fy))) (* 0.1 vz)) -25 25))
             (dt (quake:frametime))
             (pitch (+ old-pitch (* (- target-pitch old-pitch) (/ dt (+ 0.09 dt))))))
        (quake:set-field! player bike-bank bank)
        (quake:set-field! player bike-pitch pitch)
        (quake:set-field! player angles_z (bike-clamp (+ (quake:field player angles_z) bank) -36 36))
        (when (= (quake:field player fixangle) 0)
          (quake:set-field! player angles_x pitch))))))

(define (bike-steering-pose player steer)
  ; The world model starts centered, followed by three turn poses on each side.
  (let* ((degrees (bike-abs steer))
         (step (cond ((< degrees 6) 0) ((< degrees 17) 1) ((< degrees 27) 2) (else 3))))
    (quake:set-field! player frame (if (and (> steer 0) (> step 0)) (+ step 3) step))))

(define (bike-camera-for player)
  (let ((camera (quake:field player bike-camera)))
    (if (quake:world? camera)
        (let ((created (quake:spawn)))
          (quake:set-field! created classname "qslisp_bike_camera")
          (quake:set-model created "progs/bikecam.mdl")
          (quake:set-size created (quake:vector 0 0 0) (quake:vector 0 0 0))
          (quake:set-field! player bike-camera created)
          (quake:set-field! player bike-camera-yaw (quake:field player bike-heading))
          (quake:set-field! player bike-camera-floor (quake:field player origin_z))
          (quake:set-field! player bike-camera-reach 1)
          (quake:set-field! player bike-view-yaw (quake:field player v_angle_y))
          (quake:set-field! player bike-prior-view-yaw (quake:field player v_angle_y))
          created)
        camera)))

(define (bike-camera-heading player dt)
  (let* ((previous (quake:field player bike-camera-yaw))
         (turn (bike-wrap-angle (- (quake:field player bike-heading) previous)))
         (yaw (bike-wrap-angle (+ previous (* turn (/ dt (+ 0.22 dt)))))))
    (quake:set-field! player bike-camera-yaw yaw)
    yaw))

(define (bike-stock-view yaw)
  ; NetQuake adds an integer punch angle to the rendered byte angle. Pair
  ; them to approximate smooth yaw while the input still reads the byte angle.
  (let* ((base (* 1.40625 (quake:floor (+ (/ yaw 1.40625) 0.5))))
         (error (- yaw base))
         (direction (if (< error 0) -1 1))
         (gap (bike-abs error))
         (punch (cond ((< gap 0.09375) 0)
                      ((< gap 0.296875) 3)
                      ((< gap 0.5) -1)
                      (else 2)))
         (shift (cond ((< gap 0.09375) 0)
                      ((< gap 0.296875) -2.8125)
                      ((< gap 0.5) 1.40625)
                      (else -1.40625)))
         (wire (bike-wrap-angle (+ base (* shift direction))))
         ; Stock WriteAngle truncates to whole degrees before packing the byte.
         (command (+ wire (if (< wire 0) -0.99 0.99))))
    (quake:vector command (* direction punch) 0)))

(define (bike-chase-view player)
  (let* ((camera (bike-camera-for player))
         (dt (quake:frametime))
         (yaw (bike-camera-heading player dt)))
    (quake:make-vectors (quake:vector 0 yaw 0))
    (let* ((x (quake:field player origin_x))
           (y (quake:field player origin_y))
           (z (quake:field player origin_z))
           (previous (quake:field player bike-camera-floor))
           (floor (bike-clamp (+ previous (* (- z previous) (/ dt (+ 0.12 dt)))) (- z 24) (+ z 24)))
           (dx (* -156 (quake:forward-x)))
           (dy (* -156 (quake:forward-y)))
           (eye (+ z (quake:field player view_ofs_z)))
           (raise (+ 52 (- floor z))))
      (quake:set-field! player bike-camera-floor floor)
      (quake:traceline (quake:vector x y eye)
                       (quake:vector (+ x dx) (+ y dy) (+ eye raise)) 1 player)
      (let* ((fraction (quake:trace-fraction))
             (clearance (if (= fraction 1) 1 (bike-clamp (- fraction 0.05) 0 1)))
             ; Shorten against walls, then ease back out using the same view entity.
             (reach (bike-clamp (+ (quake:field player bike-camera-reach) (* 2.3 dt)) 0 clearance)))
        (quake:set-field! player bike-camera-reach reach)
        (quake:set-origin camera
          (quake:vector (+ x (* dx reach)) (+ y (* dy reach)) (+ z (* raise reach))))))
    (let* ((pitch (quake:field player v_angle_x))
           ; Identify the input precision by the reply to the fixed camera pitch.
           (previous-format (quake:field player bike-angle-format))
           (format (cond ((= pitch 16.875) 1)
                         ((= pitch 19.6875) 2)
                         ((< (bike-abs (- pitch bike-chase-pitch)) 0.02) 3)
                         ((= previous-format 0) 1)
                         (else previous-format)))
           (smooth (and (= format 1) (= (quake:coop) 0)))
           (view (if smooth (bike-stock-view yaw) (quake:vector yaw 0 0)))
           (command (quake:vector-x view))
           (view-yaw (bike-view-reply command format))
           (view-pitch (cond ((= format 1) 16.875) ((= format 2) 19.6875) (else bike-chase-pitch))))
      (when (or (and smooth (not (= command (quake:field player bike-view-command-yaw))))
                (> (bike-abs (bike-wrap-angle (- view-yaw (quake:field player v_angle_y)))) 0.02)
                (> (bike-abs (- view-pitch pitch)) 0.02))
        (quake:set-view-angles! player bike-chase-pitch command 0))
      (quake:set-field! player punchangle_y (quake:vector-y view))
      (quake:set-field! player bike-view-command-yaw command)
      (quake:set-field! player bike-angle-format format)
      (quake:set-field! player bike-prior-view-yaw (quake:field player bike-view-yaw))
      (quake:set-field! player bike-view-yaw view-yaw))
    (when (or (not (quake:entity=? camera (quake:field player bike-view)))
              (>= (quake:time) (quake:field player bike-next-view)))
      (quake:set-view player camera)
      (quake:set-field! player bike-view camera)
      ; A saved-game sign-on initially points the client back at the rider.
      (quake:set-field! player bike-next-view (+ (quake:time) 0.25)))))

(define (bike-tire-effects player)
  (let* ((now (quake:time))
         (grounded (> (quake:bit-and (quake:field player flags) flag-ground) 0))
         (supported (or grounded (= (quake:field player bike-bank-contact) 1)))
         (air-time (quake:field player bike-air-time)))
    (if supported
        (begin
          (when (>= air-time 0.075)
            (quake:set-field! player bike-landing-dust-until (+ now 0.22))
            (quake:set-field! player bike-next-dust now))
          (quake:set-field! player bike-air-time 0))
        (quake:set-field! player bike-air-time (+ air-time (quake:frametime))))
    (let ((vx (quake:field player bike-vx)) (vy (quake:field player bike-vy))
          (landing (< now (quake:field player bike-landing-dust-until)))
          (braking (or (> (quake:field player button2) 0) (= (quake:field player bike-skidding) 1))))
      (when (and supported (or landing braking) (> (+ (* vx vx) (* vy vy)) 8100)
                 (>= now (quake:field player bike-next-dust)))
        (quake:set-field! player bike-next-dust (+ now 0.10))
        (quake:make-vectors (quake:vector 0 (quake:field player bike-heading) 0))
        (let ((x (- (quake:field player origin_x) (* 17 (quake:forward-x))))
              (y (- (quake:field player origin_y) (* 17 (quake:forward-y))))
              (z (quake:field player origin_z)))
          (quake:traceline (quake:vector x y z) (quake:vector x y (- z 56)) 1 player)
          (when (> (quake:trace-normal-z) 0.7)
            (let ((surface (quake:trace-end-z)))
              (quake:particle (quake:vector x y (+ surface 3))
                              (quake:vector (* -0.008 vx) (* -0.008 vy) 0.8) 168 (if landing 20 12))
              (when braking
                (quake:particle (quake:vector x y (+ surface 8))
                                (quake:vector (* -0.004 vx) (* -0.004 vy) 1.6) 8 7)))))))))

(define (bike-bank-wall player)
  ; Test beyond the hull in the direction the bike is pointing.
  (let ((x (quake:field player origin_x)) (y (quake:field player origin_y))
        (z (+ (quake:field player origin_z) 6))
        (fx (quake:forward-x)) (fy (quake:forward-y)))
    (quake:traceline (quake:vector x y z)
                     (quake:vector (+ x (* 28 fx)) (+ y (* 28 fy)) z) 1 player)
    (if (= (quake:trace-normal-z) 0)
        (quake:vector (quake:trace-normal-x) (quake:trace-normal-y) 0)
        (quake:vector 0 0 0))))

(define (bike-bank-step player)
  (let ((vx (quake:field player velocity_x)) (vy (quake:field player velocity_y)))
    (when (and (= (quake:field player bike-bank-contact) 1)
               (> (quake:bit-and (quake:field player flags) flag-ground) 0)
               (> (quake:field player button0) 0) (= (quake:field player button2) 0)
               (< (+ (* vx vx) (* vy vy)) 25))
      ; Two expanded clip planes can cancel the drive at a brush join.
      ; Stock walkmove can settle the same hull onto the next facet.
      (quake:walkmove (quake:field player bike-heading)
                      (bike-clamp (* 75 (quake:frametime)) 0 4)))))

(define (ride-bike player)
  (let* ((dt (quake:frametime))
         (vx (quake:field player bike-vx))
         (vy (quake:field player bike-vy))
         (heading (quake:field player bike-heading))
         (aim (bike-steering-yaw player))
         (turn (bike-wrap-angle (- aim heading)))
         (banked (= (quake:field player bike-bank-contact) 1))
         (grounded (or banked (> (quake:bit-and (quake:field player flags) flag-ground) 0)))
         (braking (> (quake:field player button2) 0))
         (reversing (bike-reverse-input player braking))
         (pedaling (and (not braking) (> (quake:field player button0) 0)))
         (contact (if grounded (bike-approach (quake:field player bike-contact-grip) 1 (* 5 dt)) 0)))
    (quake:make-vectors (quake:vector 0 heading 0))
    (let* ((speed (+ (* vx (quake:forward-x)) (* vy (quake:forward-y))))
           (backwards (or (< speed -1) (and reversing (<= speed 1))))
           (target (bike-clamp (if backwards (- turn) turn) -32 32))
           (front (bike-approach (quake:field player bike-front-angle) target (* 360 dt))))
      ; The wheel responds in the air. Body yaw and tire forces return with contact.
      (quake:set-field! player bike-front-angle front)
      (quake:set-field! player bike-contact-grip contact)
      (bike-steering-pose player front)
      (if grounded
          (let* ((wall (if (and banked pedaling (< (+ (* vx vx) (* vy vy)) 10000))
                           (bike-bank-wall player) (quake:vector 0 0 0)))
                 (nx (quake:vector-x wall))
                 (ny (quake:vector-y wall))
                 (against-wall (or (not (= nx 0)) (not (= ny 0))))
                 (slip (bike-update-slip player speed braking dt))
                 (tire-dt (* dt contact contact (- 3 (* 2 contact))))
                 (limit (* 360 tire-dt))
                 ; Pedal and steer the frame away when the bank wall blocks travel.
                 (steering-speed (cond (against-wall 105)
                                       ((and banked pedaling (< (bike-abs speed) 58)) 58)
                                       (else speed)))
                 (rotation (bike-clamp (* (/ steering-speed bike-wheelbase) front tire-dt (- 1.8 (* 0.8 slip)))
                                       (- limit) limit))
                 (yaw (bike-wrap-angle (+ heading rotation))))
            (quake:make-vectors (quake:vector 0 yaw 0))
            (let* ((fx (quake:forward-x))
                   (fy (quake:forward-y))
                   (longitudinal (+ (* vx fx) (* vy fy)))
                   (lateral (- (* vy fx) (* vx fy)))
                   (traction (- 1 slip))
                   (grip (+ 0.65 (* 24 traction traction)))
                   ; Damping remains positive at different server frame lengths.
                   (slide (/ lateral (+ 1 (* grip tire-dt))))
                   (cornering (bike-clamp (+ (/ (bike-abs front) 26) (/ (bike-abs slide) 105)) 0 1))
                   (braking-rate (- 480 (* 335 slip cornering)))
                   (forward (bike-drive-speed longitudinal tire-dt pedaling braking
                                (and reversing (< (bike-abs slide) 40)) braking-rate))
                   (move-x (- (* forward fx) (* slide fy)))
                   (move-y (+ (* forward fy) (* slide fx)))
                   (into-wall (+ (* move-x nx) (* move-y ny)))
                   (next-vx (if (< into-wall 0) (- move-x (* into-wall nx)) move-x))
                   (next-vy (if (< into-wall 0) (- move-y (* into-wall ny)) move-y)))
              (quake:set-field! player velocity_x next-vx)
              (quake:set-field! player velocity_y next-vy)
              ; Feed in most of the climb speed, then let the hull settle onto
              ; the bank. The launch ramps keep ordinary ballistic motion.
              (when banked
                (quake:set-field! player velocity_z
                  (+ (* 0.72 (+ (* next-vx (quake:field player bike-grade-x))
                                (* next-vy (quake:field player bike-grade-y))))
                     (* dt (- (quake:cvar "sv_gravity") 440)))))
              (quake:set-field! player bike-heading yaw)
              (quake:set-field! player angles_y yaw)
              (quake:set-field! player angles_z (* contact (bike-clamp (* front speed -0.0016) -18 18)))
              (bike-skid player (and (> slip 0.15) (> (bike-abs slide) 45)))))
          (begin
            (quake:set-field! player velocity_x vx)
            (quake:set-field! player velocity_y vy)
            (quake:set-field! player angles_y heading)
            (quake:set-field! player angles_z 0)
            (bike-update-slip player 0 #f dt)
            (bike-skid player #f))))))

(define (bike-skid player sliding)
  (if sliding
      (when (= (quake:field player bike-skidding) 0)
        (quake:set-field! player bike-skidding 1)
        (quake:sound player 3 "misc/bikeskid.wav" 0.85 1)
        (quake:dprint "qslisp: bike rear-wheel slide\n"))
      (quake:set-field! player bike-skidding 0)))

(define (qslisp_bike_relay)
  (let ((relay (quake:self)))
    (quake:set-model relay (quake:field relay model))
    (quake:set-field! relay solid solid-trigger)
    (quake:set-origin relay (quake:field relay origin))
    (quake:set-callback! relay touch calibrate-bike-relay)))

(define (calibrate-bike-relay)
  (let ((relay (quake:self)) (player (quake:other)))
    (when (and (active-player? player) (riding-bike? player)
               (= (quake:field relay bike-relay-active) 0))
      (quake:set-field! relay bike-relay-active 1)
      (quake:set-field! relay effects 4)
      (quake:sound player 2 "misc/medkey.wav" 1 1)
      (quake:centerprint player "Service relay online.")
      (quake:dprint "qslisp: bike relay online\n"))))
