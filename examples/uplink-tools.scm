; An authored relay pulse and a shared pull/swing tool for stock NetQuake.
(define-field pulse-recipient entity)
(define-field tether-anchor entity)
(define-field tether-swing)
(define-field tether-length)
(define-field tether-ready)
(define-field tether-next-beam)
(define tether-weapon 8)

(define (uplink-tool-model subject model)
  (quake:precache-model "progs/tethanch.mdl")
  (quake:set-model subject model)
  (quake:set-field! subject solid 2)
  (quake:set-size subject (quake:vector -12 -12 -12) (quake:vector 12 12 12))
  (quake:set-field! subject effects 4))

(define (uplink_pulse_relay)
  (uplink-tool-model (quake:self) "progs/tethanch.mdl"))

(define (uplink-pulse-contact player hit)
  (let ((relay (string=? (quake:field hit classname) "uplink_pulse_relay")))
    (when (or relay (string=? (quake:field hit targetname) "switch-guard"))
      (let* ((target (if relay (find-linked hit) hit))
             (spark (quake:spawn)))
        (quake:set-field! spark classname "uplink_pulse")
        (quake:set-field! spark owner player)
        (quake:set-field! spark pulse-recipient target)
        (quake:particle (quake:field hit origin) (quake:vector 0 0 0.4) 224 14)
        (quake:set-callback! spark think uplink-pulse-impact)
        (quake:set-field! spark nextthink (+ (quake:time) 0.22))))
    relay))

(define-sequence
  (step uplink-pulse-impact
    (let* ((spark (quake:self)) (target (quake:field spark pulse-recipient))
           (player (quake:field spark owner)))
      (when (and (active-player? player) (not (quake:world? target)))
        (cond
          ((string=? (quake:field target classname) "uplink_station")
           (quake:call-callback target use player))
          ((string=? (quake:field target targetname) "switch-guard")
           (quake:particle (quake:field target origin) (quake:vector 0 0 0.7) 224 18)
           (damage target player 9)))
        (quake:dprint "uplink: pulse resolved\n"))
      (after 0.05 uplink-pulse-remove)))
  (step uplink-pulse-remove
    (quake:remove (quake:self))))

(define (uplink_anchor)
  (uplink-tool-model (quake:self) "progs/tethanch.mdl"))

(define (uplink_tether_supply)
  (quake:precache-model "progs/beam.mdl")
  (quake:precache-model "progs/tether.mdl")
  (set-pickup-model (quake:self) "progs/tether.mdl")
  (quake:set-callback! (quake:self) touch uplink-tether-pickup))

(define (uplink-tether-pickup)
  (let* ((player (quake:other)) (items (quake:field player items)))
    (when (and (active-player? player) (= (quake:bit-and items tether-weapon) 0))
      (quake:set-field! player items (quake:bit-or items tether-weapon))
      (quake:centerprint player "Tether launcher. Press 3 to equip. Hold fire to attach, release to let go.")
      (quake:dprint "uplink: tether acquired\n"))))

(define (clear-tether player)
  (when (not (quake:world? (quake:field player tether-anchor)))
    (quake:set-field! player tether-anchor (quake:world))
    (quake:set-field! player weaponframe 0)
    (trace-tether-event player 0)
    (quake:dprint "uplink: tether released\n")))

(define (tether-offset player anchor)
  (quake:vector (- (quake:field anchor origin_x) (quake:field player origin_x))
                (- (quake:field anchor origin_y) (quake:field player origin_y))
                (- (quake:field anchor origin_z) (quake:field player origin_z))))

(define (tether-attach player)
  (let* ((anchor (aimed-entity player 800))
         (valid (string=? (quake:field anchor classname) "uplink_anchor")))
    (quake:set-field! player tether-ready 0)
    (trace-tether-aim player (if valid 1 0))
    (when valid
      (quake:set-field! player tether-anchor anchor)
      (quake:set-field! player tether-length (quake:vector-length (tether-offset player anchor)))
      (quake:set-field! player tether-next-beam 0)
      (quake:set-field! player weaponframe 1)
      (quake:sound player 1 "misc/medkey.wav" 0.65 1)
      (trace-tether-event player 1)
      (quake:dprint "uplink: tether attached\n"))))

(define (tether-draw player anchor)
  (when (>= (quake:time) (quake:field player tether-next-beam))
    (quake:beam player (quake:field player origin) (quake:field anchor origin))
    (quake:set-field! player tether-next-beam (+ (quake:time) 0.08))))

(define (tether-maintain player anchor)
  (let* ((offset (tether-offset player anchor))
         (distance (quake:vector-length offset))
         (clear (quake:entity=? anchor
                  (quake:traceline (quake:field player origin) (quake:field anchor origin) 0 player))))
    (if (or (not clear) (< distance 30) (> distance 840))
        (clear-tether player)
        (let* ((x (/ (quake:vector-x offset) distance))
               (y (/ (quake:vector-y offset) distance))
               (z (/ (quake:vector-z offset) distance)))
          (tether-draw player anchor)
          (if (= (quake:field anchor tether-swing) 0)
              (quake:set-field! player velocity (quake:vector (* x 440) (* y 440) (* z 440)))
              (tether-swing-step player distance x y z))))))

(define (tether-swing-step player distance x y z)
  (let* ((dt (quake:frametime))
         (vx (quake:field player velocity_x)) (vy (quake:field player velocity_y))
         (vz (quake:field player velocity_z))
         (radial (+ (* vx x) (* vy y) (* (- vz (* dt (quake:cvar "sv_gravity"))) z)))
         (limit (bike-clamp (/ (- distance (quake:field player tether-length)) dt) -420 130))
         (correction (bike-clamp (- limit radial) 0 420)))
    ; Only the outward component is constrained. The stock hull moves and clips normally.
    (quake:set-field! player velocity (quake:vector (+ vx (* x correction))
                                         (+ vy (* y correction)) (+ vz (* z correction))))))

(define (update-tether player)
  (let ((anchor (quake:field player tether-anchor)))
    (cond
      ((= (quake:field player button0) 0)
       (clear-tether player)
       (quake:set-field! player tether-ready 1))
      ((not (quake:world? anchor)) (tether-maintain player anchor))
      ((= (quake:field player tether-ready) 1) (tether-attach player)))))
