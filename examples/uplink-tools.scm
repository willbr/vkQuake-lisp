; An authored relay pulse and a shared pull/swing tool for stock NetQuake.
(define-field pulse-recipient entity)
(define-field tether-anchor entity)
(define-field tether-swing)
(define-field tether-length)
(define-field tether-ready)
(define-field tether-next-beam)
(define-field tether-held)
(define-field tether-owned)
(define-field tether-jump-armed)
(define-field tether-px)
(define-field tether-py)
(define-field tether-pz)

(define (uplink-tool-model subject model)
  (quake:precache-model "progs/tethanch.mdl")
  (quake:set-model subject model)
  (quake:set-field! subject solid 2)
  (quake:set-size subject (quake:vector -12 -12 -12) (quake:vector 12 12 12))
  (quake:set-field! subject effects 4))

(define (uplink_pulse_relay)
  (uplink-tool-model (quake:self) "progs/tethanch.mdl"))

(define (uplink-pulse-contact player hit)
  (let ((relay (string=? (quake:field hit classname) "uplink_pulse_relay")))
    (when (or relay (string=? (quake:field hit targetname) "switch-guard"))
      (let* ((target (if relay (find-linked hit) hit))
             (spark (quake:spawn)))
        (quake:set-field! spark classname "uplink_pulse")
        (quake:set-field! spark owner player)
        (quake:set-field! spark pulse-recipient target)
        (quake:particle (quake:field hit origin) (quake:vector 0 0 0.4) 224 14)
        (quake:set-callback! spark think uplink-pulse-impact)
        (quake:set-field! spark nextthink (+ (quake:time) 0.22))))
    relay))

(define-sequence
  (step uplink-pulse-impact
    (let* ((spark (quake:self)) (target (quake:field spark pulse-recipient))
           (player (quake:field spark owner)))
      (when (and (active-player? player) (not (quake:world? target)))
        (cond
          ((string=? (quake:field target classname) "uplink_station")
           (quake:call-callback target use player))
          ((string=? (quake:field target targetname) "switch-guard")
           (quake:particle (quake:field target origin) (quake:vector 0 0 0.7) 224 18)
           (damage target player 9)))
        (quake:dprint "uplink: pulse resolved\n"))
      (after 0.05 uplink-pulse-remove)))
  (step uplink-pulse-remove
    (quake:remove (quake:self))))

;; Mouse2 tether. Stock clients send only the attack and jump buttons, so the
;; mod's autoexec binds Mouse2 to "+tether", whose halves send impulses 30 and 31.
;; Impulses can be overwritten or dropped, so jump also lets go and a second
;; press re-fires at a new anchor instead of depending on the release.
(define (uplink_anchor)
  (uplink-tool-model (quake:self) "progs/tethanch.mdl"))

; A brush anchor lets a whole girder or rail take the tether where the aim hits it.
(define (uplink_anchor_rail)
  (let ((rail (quake:self)))
    (quake:set-field! rail movetype move-push)
    (quake:set-field! rail solid solid-brush)
    (quake:set-model rail (quake:field rail model))))

(define (uplink_tether_supply)
  (quake:precache-model "progs/beam.mdl")
  (quake:precache-model "progs/tether.mdl")
  (set-pickup-model (quake:self) "progs/tether.mdl")
  (quake:set-callback! (quake:self) touch uplink-tether-pickup))

(define (uplink-tether-pickup)
  (let ((player (quake:other)))
    (when (and (active-player? player) (= (quake:field player tether-owned) 0))
      (quake:set-field! player tether-owned 1)
      (quake:centerprint player "Tether launcher. Hold Mouse2 at a marked anchor.\nRelease or jump to let go.")
      (quake:dprint "uplink: tether acquired\n"))))

(define (clear-tether player)
  (when (not (quake:world? (quake:field player tether-anchor)))
    (quake:set-field! player tether-anchor (quake:world))
    (trace-tether-event player 0)
    (quake:dprint "uplink: tether released\n")))

(define (tether-point player)
  (quake:vector (quake:field player tether-px) (quake:field player tether-py) (quake:field player tether-pz)))

(define (tether-offset player)
  (quake:vector (- (quake:field player tether-px) (quake:field player origin_x))
                (- (quake:field player tether-py) (quake:field player origin_y))
                (- (quake:field player tether-pz) (quake:field player origin_z))))

(define (anchor-class? entity)
  (or (string=? (quake:field entity classname) "uplink_anchor")
      (string=? (quake:field entity classname) "uplink_anchor_rail")))

; Within 10 degrees of the aim, take the best-aligned point anchor with a clear line.
(define (assist-anchor player cursor eye best best-dot)
  (let ((anchor (quake:find cursor classname "uplink_anchor")))
    (if (quake:world? anchor)
        best
        (let* ((dx (- (quake:field anchor origin_x) (quake:vector-x eye)))
               (dy (- (quake:field anchor origin_y) (quake:vector-y eye)))
               (dz (- (quake:field anchor origin_z) (quake:vector-z eye)))
               (distance (quake:vector-length (quake:vector dx dy dz)))
               (dot (if (> distance 1)
                        (/ (+ (* dx (quake:forward-x)) (* dy (quake:forward-y)) (* dz (quake:forward-z))) distance)
                        0)))
          (if (and (> dot best-dot) (< distance 800)
                   (quake:entity=? anchor (quake:traceline eye (quake:field anchor origin) 0 player)))
              (assist-anchor player anchor eye anchor dot)
              (assist-anchor player anchor eye best best-dot))))))

(define (tether-attach player)
  (let* ((hit (aimed-entity player 800))
         (point (trace-end))
         (direct (anchor-class? hit))
         (anchor (if direct hit (assist-anchor player (quake:world) (player-eye player) (quake:world) 0.985)))
         (valid (not (quake:world? anchor))))
    (quake:set-field! player tether-ready 0)
    (trace-tether-aim player (if valid 1 0))
    (when valid
      (let ((at (if (string=? (quake:field anchor classname) "uplink_anchor_rail") point (quake:field anchor origin))))
        (quake:set-field! player tether-anchor anchor)
        (quake:set-field! player tether-px (quake:vector-x at))
        (quake:set-field! player tether-py (quake:vector-y at))
        (quake:set-field! player tether-pz (quake:vector-z at))
        (quake:set-field! player tether-length (quake:vector-length (tether-offset player)))
        (quake:set-field! player tether-next-beam 0)
        (quake:set-field! player tether-jump-armed (if (> (quake:field player button2) 0) 0 1))
        (quake:sound player 1 "misc/medkey.wav" 0.65 1)
        (trace-tether-event player 1)
        (quake:dprint "uplink: tether attached\n")))))

(define (tether-draw player)
  (when (>= (quake:time) (quake:field player tether-next-beam))
    (quake:beam player (quake:field player origin) (tether-point player))
    (quake:set-field! player tether-next-beam (+ (quake:time) 0.08))))

(define (tether-clear-line? player anchor distance offset)
  ; Trace a little past the attachment so a surface point still reports its brush.
  (let ((reach (/ (+ distance 8) distance)) (origin (quake:field player origin)))
    (quake:entity=? anchor
      (quake:traceline origin (quake:vector (+ (quake:vector-x origin) (* reach (quake:vector-x offset)))
                                            (+ (quake:vector-y origin) (* reach (quake:vector-y offset)))
                                            (+ (quake:vector-z origin) (* reach (quake:vector-z offset))))
                       0 player))))

(define (tether-maintain player anchor)
  (let* ((offset (tether-offset player))
         (distance (quake:vector-length offset)))
    (if (or (< distance 30) (> distance 840) (not (tether-clear-line? player anchor distance offset)))
        (clear-tether player)
        (let* ((x (/ (quake:vector-x offset) distance))
               (y (/ (quake:vector-y offset) distance))
               (z (/ (quake:vector-z offset) distance)))
          (tether-draw player)
          (if (= (quake:field anchor tether-swing) 0)
              (let ((pull (tunable 2 440)))
                (quake:set-field! player velocity (quake:vector (* x pull) (* y pull) (* z pull))))
              (tether-swing-step player distance x y z))))))

(define (tether-swing-step player distance x y z)
  (let* ((dt (quake:frametime))
         (vx (quake:field player velocity_x)) (vy (quake:field player velocity_y))
         (vz (quake:field player velocity_z))
         (radial (+ (* vx x) (* vy y) (* (- vz (* dt (quake:cvar "sv_gravity"))) z)))
         (limit (bike-clamp (/ (- distance (quake:field player tether-length)) dt) -420 130))
         (correction (bike-clamp (- limit radial) 0 420)))
    ; Only the outward component is constrained. The stock hull moves and clips normally.
    (quake:set-field! player velocity (quake:vector (+ vx (* x correction))
                                         (+ vy (* y correction)) (+ vz (* z correction))))))

(define (tether-input player)
  (let ((command (quake:field player impulse)))
    (when (or (= command 30) (= command 31))
      (quake:set-field! player impulse 0)
      (quake:set-field! player tether-held (if (= command 30) 1 0))
      (when (= command 30) (quake:set-field! player tether-ready 1)))))

(define (update-tether player)
  (let ((anchor (quake:field player tether-anchor))
        (jump (> (quake:field player button2) 0)))
    (when (and (not jump) (not (quake:world? anchor)))
      (quake:set-field! player tether-jump-armed 1))
    (cond
      ((= (quake:field player tether-owned) 0) #f)
      ((or (= (quake:field player tether-held) 0)
           (and jump (not (quake:world? anchor)) (= (quake:field player tether-jump-armed) 1)))
       (clear-tether player)
       (quake:set-field! player tether-held 0))
      ((= (quake:field player tether-ready) 1) (tether-attach player))
      ((not (quake:world? anchor)) (tether-maintain player anchor)))))
