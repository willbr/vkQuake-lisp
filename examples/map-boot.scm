; Explore stock Quake and play the original Signal Room challenge.
(define-field next-shot)
(define-field gate-open)
(define-field linked-gate entity)
(define-field room-complete)
(define move-walk 3)
(define move-push 7)
(define solid-trigger 1)
(define solid-slidebox 3)
(define solid-brush 4)
(define flag-client 8)
(define flag-ground 512)
(define flag-jump-ready 4096)

(define (worldspawn)
  (quake:precache-model "progs/player.mdl")
  (quake:precache-model "progs/v_shot.mdl")
  (quake:precache-sound "weapons/sgun1.wav")
  (quake:precache-sound "misc/medkey.wav")
  (quake:dprint "qslisp: worldspawn\n"))

(define (StartFrame)
  ; Record the startup frames without flooding the console during play.
  (if (< (quake:time) 1.4)
      (quake:dprint "qslisp: StartFrame\n")
      0))

(define (SetNewParms) 0)
(define (SetChangeParms) 0)
(define (ClientDisconnect) 0)
(define (ClientKill) 0)
(define (info_player_start) 0)
(define (light) 0)

(define (qslisp_target)
  (let ((plate (quake:self)))
    (quake:set-field! plate movetype move-push)
    (quake:set-field! plate solid solid-brush)
    (quake:set-model plate (quake:field plate model))
    (quake:set-callback! plate use finish-challenge)))

(define (qslisp_gate)
  (let ((gate (quake:self)))
    (quake:set-field! gate movetype move-push)
    (quake:set-field! gate solid solid-brush)
    (quake:set-model gate (quake:field gate model))
    (quake:set-callback! gate use open-gate)
    (quake:set-callback! gate think stop-gate)))

(define (open-gate)
  (let ((gate (quake:self)))
    (when (= (quake:field gate gate-open) 0)
      (quake:set-field! gate gate-open 1)
      (quake:set-field! gate velocity_z 320)
      (quake:set-field! gate nextthink (+ (quake:field gate ltime) 0.5)))))

(define (stop-gate)
  (let ((gate (quake:self)))
    (quake:set-field! gate velocity_z 0)
    (quake:set-field! gate solid 0)
    (quake:set-field! gate gate-open 2)
    (quake:set-origin gate (quake:field gate origin))
    (quake:dprint "qslisp: gate open\n")))

(define (qslisp_exit)
  (let ((exit (quake:self)))
    (quake:set-field! exit solid solid-trigger)
    (quake:set-model exit (quake:field exit model))
    (quake:set-field! exit modelindex 0)
    (quake:set-callback! exit touch touch-exit)))

(define (find-linked entity)
  (quake:find (quake:world) targetname (quake:field entity target)))

(define (touch-exit)
  (let ((exit (quake:self)) (player (quake:other)))
    (when (and (= (quake:field exit room-complete) 0)
               (= (quake:bit-and (quake:field player flags) flag-client) flag-client)
               (> (quake:field player health) 0))
      (when (quake:world? (quake:field exit linked-gate))
        (quake:set-field! exit linked-gate (find-linked exit)))
      (let ((gate (quake:field exit linked-gate)))
        (when (and (not (quake:world? gate)) (= (quake:field gate gate-open) 2))
          (quake:set-field! exit room-complete 1)
          (quake:set-field! player movetype 0)
          (quake:set-field! player velocity (quake:vector 0 0 0))
          (quake:centerprint player "Signal Room complete!\n\nPress R to reset.")
          (quake:dprint "qslisp: level complete\n"))))))

(define (ClientConnect)
  (quake:dprint "qslisp: ClientConnect\n"))

(define (update-ammo player rounds)
  (quake:set-field! player ammo_shells rounds)
  (quake:set-field! player currentammo rounds))

(define (update-jump player)
  (let* ((flags (quake:field player flags))
         (ready (quake:bit-and flags flag-jump-ready)))
    (cond ((= (quake:field player button2) 0)
           (when (= ready 0)
             (quake:set-field! player flags (quake:bit-or flags flag-jump-ready))))
          ((= ready 0) 0)
          (else
            (let ((remaining (- flags ready)))
              (if (= (quake:bit-and flags flag-ground) 0)
                  (quake:set-field! player flags remaining)
                  (begin
                    (quake:set-field! player flags (- remaining flag-ground))
                    (quake:set-field! player velocity_z 270)
                    (quake:dprint "qslisp: jump\n"))))))))

(define (finish-challenge)
  (let* ((plate (quake:self)) (player (quake:other)) (gate (find-linked plate)))
    (when (not (quake:world? gate))
      (quake:call-callback gate use player))
    (quake:remove plate)
    (quake:sound player 2 "misc/medkey.wav" 1 1)
    (quake:centerprint player "Signal restored!\n\nProceed through the gate.")
    (quake:dprint "qslisp: target hit\n")))

(define (fire player rounds)
  (update-ammo player (- rounds 1))
  (quake:set-field! player weaponframe 1)
  (quake:set-field! player punchangle_x -2)
  (quake:sound player 1 "weapons/sgun1.wav" 1 1)
  (quake:dprint "qslisp: fired\n")
  (quake:make-vectors (quake:field player v_angle))
  (let ((x (quake:field player origin_x))
        (y (quake:field player origin_y))
        (z (+ (quake:field player origin_z) (quake:field player view_ofs_z)))
        (range 800))
    (let ((hit (quake:traceline (quake:vector x y z)
                                (quake:vector (+ x (* range (quake:forward-x)))
                                              (+ y (* range (quake:forward-y)))
                                              (+ z (* range (quake:forward-z))))
                                0 player)))
      (when (and (not (quake:world? hit)) (string=? (quake:field hit classname) "qslisp_target"))
        (quake:call-callback hit use player)))))

(define (update-weapon player)
  (let ((now (quake:time))
        (next (quake:field player next-shot)))
    (if (> next now)
        0
        (if (= (quake:field player button0) 0)
            (if (= (quake:field player weaponframe) 0)
                0
                (quake:set-field! player weaponframe 0))
            (let ((rounds (quake:field player ammo_shells)))
              (quake:set-field! player next-shot (+ now 0.35))
              (if (> rounds 0)
                  (fire player rounds)
                  (quake:centerprint player "Out of shells.\nPress R to reset.")))))))

(define (PlayerPreThink)
  (let ((player (quake:self)))
    (when (and (> (quake:field player health) 0) (= (quake:field player movetype) move-walk))
      (update-jump player)
      (update-weapon player))))

(define (PlayerPostThink) 0)

(define (PutClientInServer)
  (let ((player (quake:self))
        (spot (quake:find (quake:world) classname "info_player_start")))
    (if (quake:world? spot)
        (quake:error "qslisp: map has no info_player_start\n")
        (begin
          (quake:set-field! player health 100)
          (quake:set-field! player movetype move-walk)
          (quake:set-field! player solid solid-slidebox)
          (quake:set-field! player flags flag-client)
          (quake:set-field! player fixangle 1)
          (quake:set-field! player items 257) ; IT_SHOTGUN | IT_SHELLS
          (quake:set-field! player weapon 1)
          (quake:set-field! player weaponmodel "progs/v_shot.mdl")
          (update-ammo player 3)
          (quake:set-field! player angles (quake:field spot angles))
          (quake:set-field! player view_ofs (quake:vector 0 0 22))
          (quake:set-model player "progs/player.mdl")
          (quake:set-size player (quake:vector -16 -16 -24) (quake:vector 16 16 32))
          (quake:set-origin player (quake:vector (quake:field spot origin_x)
                                                (quake:field spot origin_y)
                                                (+ (quake:field spot origin_z) 1)))
          (quake:dprint "qslisp: player spawned\n")))))
