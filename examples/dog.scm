; id's dog.qc as one Lisp state machine. QuakeC spends a function per frame;
; here each state is a frame range and one think steps through it.
(define-field dog-state)
(define-field dog-step)
(define-field dog-last-health)
(define-field dog-pain-until)

(define dog-stand 0)
(define dog-run 1)
(define dog-bite 2)
(define dog-leap 3)
(define dog-pain 4)

; First frame of each animation in progs/dog.mdl, in the order of dog.qc's $frame lines.
(define (dog-first-frame state)
  (cond ((= state dog-run) 48) ((= state dog-bite) 0) ((= state dog-leap) 60)
        ((= state dog-pain) 26) (else 69)))

(define (dog-frame-count state)
  (cond ((= state dog-run) 12) ((= state dog-bite) 8) ((= state dog-leap) 9)
        ((= state dog-pain) 6) (else 9)))

; dog_run1-12 call ai_run with these distances.
(define (dog-run-distance step)
  (let ((step (- step (* 6 (quake:floor (/ step 6))))))
    (cond ((= step 0) 16) ((= step 3) 20) ((= step 4) 64) (else 32))))

(define (lambda_dog)
  (let ((dog (quake:self)))
    (quake:precache-model "progs/dog.mdl")
    (quake:precache-sound "dog/dattack1.wav")
    (quake:precache-sound "dog/ddeath.wav")
    (quake:precache-sound "dog/dpain1.wav")
    (quake:precache-sound "dog/dsight.wav")
    (quake:precache-sound "dog/idle.wav")
    (quake:set-field! dog solid solid-slidebox)
    (quake:set-field! dog movetype move-step)
    (quake:set-field! dog flags flag-monster)
    (quake:set-model dog "progs/dog.mdl")
    (quake:set-size dog (quake:vector -32 -32 -24) (quake:vector 32 32 40))
    (quake:set-field! dog health 25)
    (quake:set-field! dog dog-last-health 25)
    (quake:set-field! dog takedamage 2)
    (quake:set-field! dog yaw_speed 20)
    (quake:set-field! dog ideal_yaw (quake:field dog angles_y))
    (quake:drop-to-floor)
    (count-monster)
    (quake:set-callback! dog think dog-think)
    (quake:set-field! dog nextthink (+ (quake:time) 0.1 (* 0.01 (quake:field dog origin_x))))))

(define (dog-enter dog state)
  (quake:set-field! dog dog-state state)
  (quake:set-field! dog dog-step 0))

(define (dog-distance dog enemy)
  (quake:vector-length (quake:vector (- (quake:field enemy origin_x) (quake:field dog origin_x))
                                     (- (quake:field enemy origin_y) (quake:field dog origin_y))
                                     (- (quake:field enemy origin_z) (quake:field dog origin_z)))))

(define (dog-face dog enemy)
  (quake:set-field! dog ideal_yaw (sentry-facing dog enemy))
  (quake:change-yaw))

; CheckDogJump: the enemy is level with the dog and 80-150 units away.
(define (dog-can-leap? dog enemy)
  (let ((low (+ (quake:field enemy origin_z) (quake:field enemy mins_z)))
        (height (quake:field enemy size_z))
        (flat (quake:vector-length (quake:vector (- (quake:field enemy origin_x) (quake:field dog origin_x))
                                                 (- (quake:field enemy origin_y) (quake:field dog origin_y)) 0))))
    (and (<= (+ (quake:field dog origin_z) (quake:field dog mins_z)) (+ low (* 0.75 height)))
         (>= (+ (quake:field dog origin_z) (quake:field dog maxs_z)) (+ low (* 0.25 height)))
         (>= flat 80) (<= flat 150))))

(define (dog-run-step dog enemy step)
  (if (or (quake:world? enemy) (<= (quake:field enemy health) 0))
      (dog-enter dog dog-stand)
      (let ((distance (dog-distance dog enemy)))
        (dog-face dog enemy)
        (cond
          ((< distance 70) (dog-enter dog dog-bite))
          ((and (dog-can-leap? dog enemy) (sentry-visible? dog enemy)) (dog-enter dog dog-leap))
          (else
           (when (= step 0) (quake:sound dog 2 "dog/idle.wav" 0.4 2))
           (quake:set-field! dog goalentity enemy)
           (quake:move-to-goal (dog-run-distance step)))))))

(define (dog-bite-step dog enemy step)
  (if (quake:world? enemy)
      (dog-enter dog dog-run)
      (begin
        (dog-face dog enemy)
        (if (= step 3)
            (begin
              (quake:sound dog 2 "dog/dattack1.wav" 1 1)
              (when (and (< (dog-distance dog enemy) 100) (sentry-visible? dog enemy))
                (damage enemy dog (tunable 4 12))))
            (quake:walkmove (quake:field dog angles_y) 10)))))

(define (dog-leap-step dog enemy step)
  (cond
    ((= step 1)
     (dog-face dog enemy)
     (quake:make-vectors (quake:field dog angles))
     (quake:set-origin dog (quake:vector (quake:field dog origin_x) (quake:field dog origin_y)
                                        (+ 1 (quake:field dog origin_z))))
     (quake:set-field! dog velocity (quake:vector (* 300 (quake:forward-x)) (* 300 (quake:forward-y)) 200))
     (quake:set-field! dog flags (- (quake:field dog flags) (quake:bit-and (quake:field dog flags) flag-ground)))
     (quake:set-callback! dog touch dog-jump-touch))
    ((>= step 8) (quake:set-field! dog dog-step 7))))

; Dog_JumpTouch: bite on a fast impact, then run once back on the ground.
(define (dog-jump-touch)
  (let ((dog (quake:self)) (other (quake:other)))
    (when (> (quake:field dog health) 0)
      (when (and (> (quake:field other takedamage) 0)
                 (> (quake:vector-length (quake:field dog velocity)) 300))
        (damage other dog 15))
      (when (> (quake:bit-and (quake:field dog flags) flag-ground) 0)
        (quake:set-callback! dog touch #f)
        (dog-enter dog dog-run)))))

(define (dog-think)
  (let* ((dog (quake:self)) (state (quake:field dog dog-state)) (step (quake:field dog dog-step))
         (enemy (quake:field dog enemy)) (health (quake:field dog health)))
    (quake:set-field! dog nextthink (+ (quake:time) 0.1))
    (quake:set-field! dog frame (+ (dog-first-frame state) step))
    (quake:set-field! dog dog-step (if (< (+ step 1) (dog-frame-count state)) (+ step 1)
                                       (if (= state dog-leap) step 0)))
    (when (and (< health (quake:field dog dog-last-health)) (> (quake:time) (quake:field dog dog-pain-until)))
      (quake:set-field! dog dog-pain-until (+ (quake:time) 1.5))
      (quake:sound dog 2 "dog/dpain1.wav" 1 1)
      (dog-enter dog dog-pain))
    (quake:set-field! dog dog-last-health health)
    (cond
      ((= state dog-stand)
       (let ((player (visible-player dog (quake:world))))
         (when (not (quake:world? player))
           (quake:set-field! dog enemy player)
           (quake:sound dog 2 "dog/dsight.wav" 1 1)
           (quake:dprint "lambda: dog sighted player\n")
           (dog-enter dog dog-run))))
      ((= state dog-run) (dog-run-step dog enemy step))
      ((= state dog-bite)
       (dog-bite-step dog enemy step)
       (when (= step 7) (dog-enter dog dog-run)))
      ((= state dog-leap) (dog-leap-step dog enemy step))
      ((= step 5) (dog-enter dog dog-run)))))

; dog_die: a corpse keeps playing the death frames after damage removes the dog.
(define (dog-corpse dog)
  (let ((corpse (quake:spawn)))
    (quake:set-field! corpse classname "lambda_dog_corpse")
    (quake:set-model corpse "progs/dog.mdl")
    (quake:set-origin corpse (quake:field dog origin))
    (quake:set-field! corpse angles (quake:field dog angles))
    (quake:set-field! corpse frame 8)
    (quake:sound corpse 2 "dog/ddeath.wav" 1 1)
    (quake:set-callback! corpse think corpse-think)
    (quake:set-field! corpse nextthink (+ (quake:time) 0.1))))

(define (corpse-think)
  (let ((corpse (quake:self)))
    (when (< (quake:field corpse frame) 16)
      (quake:set-field! corpse frame (+ 1 (quake:field corpse frame)))
      (quake:set-field! corpse nextthink (+ (quake:time) 0.1)))))
