; Relay Annex's interlocks, cargo lifts, and AI teammate.
(define-field lift-travel)
(define-field lift-locked)
(define-field lift-floor)
(define-field lift-x)
(define-field lift-y)
(define-field lift-up)
(define-field lift-moving)
(define-field lift-call-stop)
(define-field buddy-state)
(define-field buddy-leader entity)
(define-field buddy-goal entity)
(define-field buddy-regroup-time)
(define-field buddy-shot)
(define-field buddy-trace-reason)
(define-field uplink-active)
(define-field uplink-hints)
(define-field hint-code)
(define-field buddy-task entity)
(define-field buddy-dwim)
(define-field buddy-spot string)
(define-field probe-relay)

(define-record uplink-log (flags number) (operator entity))
(define-saved-record read-uplink-log write-uplink-log make-uplink-log
  (uplink-saved-flags number uplink-log-flags)
  (uplink-saved-operator entity uplink-log-operator))

(define (uplink_journal) 0)

(define (uplink-record! flag player)
  (let* ((owner (uplink-named "mission-journal")) (log (read-uplink-log owner)))
    (when (= (quake:bit-and (uplink-log-flags log) flag) 0)
      (write-uplink-log owner (make-uplink-log (quake:bit-or (uplink-log-flags log) flag) player))
      ; Stock HUD keycards and sigils show progress: switchgear, the probe, extraction.
      (cond ((= flag 4) (give-players (quake:world) 131072))
            ((= flag 64) (give-players (quake:world) 262144))
            ((= flag 32) (quake:set-serverflags! (quake:bit-or (quake:serverflags) 1)))))))

(define (give-players cursor item)
  (let ((player (quake:find cursor classname "qslisp_player")))
    (when (not (quake:world? player))
      (quake:set-field! player items (quake:bit-or (quake:field player items) item))
      (give-players player item))))

(define buddy-follow 0)
(define buddy-wait 1)
(define buddy-regroup 2)
(define buddy-assist 3)

; These are the IDPO frame groups in the buddy recipe's animation order.
(define buddy-frame-idle 0)
(define buddy-frame-walk 1)
(define buddy-frame-assist 2)

(define (uplink-named name)
  (quake:find (quake:world) targetname name))

(define (uplink_buddy)
  (let ((actor (quake:self)))
    (configure-actor actor 100)
    (quake:precache-model "progs/upbuddy.mdl")
    (quake:set-model actor "progs/upbuddy.mdl")
    (quake:set-size actor (quake:vector -16 -16 0) (quake:vector 16 16 48))
    (quake:set-field! actor takedamage 0)
    (quake:set-field! actor effects 4)
    (quake:set-field! actor buddy-state buddy-wait)
    (quake:set-callback! actor use uplink-use-buddy)
    (quake:set-callback! actor think uplink-buddy-think)
    (quake:set-field! actor nextthink (+ (quake:time) 0.12))))

(define (uplink_waypoint) 0)

(define (uplink-teammate)
  (quake:find (quake:world) classname "uplink_buddy"))

(define (uplink-close? reference actor radius height)
  (and (not (quake:world? reference)) (not (quake:world? actor))
       (< (sentry-distance-squared reference actor) (* radius radius))
       (< (bike-abs (- (quake:field reference origin_z) (quake:field actor origin_z))) height)))

(define (uplink-buddy-order buddy player mode)
  (quake:set-field! buddy buddy-leader player)
  (quake:set-field! buddy buddy-state mode)
  (quake:set-field! buddy frame (if (= mode buddy-assist) buddy-frame-assist buddy-frame-idle))
  (quake:set-field! buddy buddy-goal (quake:world))
  (quake:set-field! buddy buddy-regroup-time (+ (quake:time) 1))
  (when (= mode buddy-follow)
    (let ((gate (uplink-named "bike-dock")))
      (when (not (quake:world? gate)) (quake:call-callback gate use player)))))

(define (uplink-checkpoint-recovery player)
  (when (not (quake:world? (quake:field player checkpoint)))
    (let ((buddy (uplink-teammate)))
      (when (not (quake:world? buddy))
        (let ((leader (quake:field buddy buddy-leader)))
          (when (or (quake:entity=? leader player) (not (active-player? leader)))
            (uplink-buddy-order buddy player buddy-regroup)))))))

(define (uplink_hint)
  (let ((hint (quake:self)))
    (quake:set-field! hint solid solid-trigger)
    (quake:set-model hint (quake:field hint model))
    (quake:set-field! hint modelindex 0)
    (quake:set-callback! hint touch uplink-show-hint)))

(define (uplink-show-hint)
  (let* ((player (quake:other)) (code (quake:field (quake:self) hint-code))
         (seen (quake:field player uplink-hints)))
    (when (and (active-player? player) (= (quake:bit-and seen code) 0))
      (quake:set-field! player uplink-hints (quake:bit-or seen code))
      (cond
        ((= code 1) (quake:centerprint player "Find the buddy and press E.\nTake a bike through the south gate."))
        ((= code 2) (quake:centerprint player "Freight lift to the east.\nDismount to use CALL, then press E aboard."))
        ((= code 4) (quake:centerprint player "Follow the bypass west to the valve."))
        ((= code 8) (quake:centerprint player "Use the valve to station the buddy.\nThen use the pump breaker to the east."))
        ((= code 16) (quake:centerprint player "Grab the pulse carbine.\nClear the sentry and hit the relay."))
        ((= code 32) (quake:centerprint player "Ride through both north gantry relays.\nThe tether gallery is optional."))
        ((= code 64) (quake:centerprint player "The probe is deadlocked: each relay waits for the other.\nRelease one at its station, or aim and press Q for the buddy."))))))

(define (uplink-use-buddy)
  (let ((buddy (quake:self)) (player (quake:other)))
    (when (active-player? player)
      (if (= (quake:field buddy buddy-state) buddy-follow)
          (begin
            (uplink-buddy-order buddy player buddy-wait)
            (quake:centerprint player "Buddy waiting."))
          (begin
            (uplink-buddy-order buddy player buddy-follow)
            (quake:centerprint player "Buddy following."))))))

(define (uplink-near-waypoint player cursor best)
  (let ((point (quake:find cursor classname "uplink_waypoint")))
    (if (quake:world? point)
        best
        (uplink-near-waypoint player point
          (if (and (uplink-close? point player 360 84)
                   (or (quake:world? best)
                       (< (sentry-distance-squared point player) (sentry-distance-squared best player))))
              point best)))))

(define (uplink-buddy-step actor goal radius)
  (quake:set-field! actor buddy-trace-goal goal)
  (cond
    ((not (uplink-close? actor goal 6000 58)) (quake:set-field! actor buddy-trace-reason 3))
    ((<= (sentry-distance-squared actor goal) (* radius radius))
     (quake:set-field! actor buddy-trace-reason 4))
    (else
     (let* ((direct (> (sentry-step actor goal 14) 0))
            (yaw (quake:field actor angles_y))
            (moving (or direct
                        (and (= (quake:field actor buddy-state) buddy-assist)
                             (or (> (quake:walkmove (+ yaw 90) 14) 0)
                                 (> (quake:walkmove (- yaw 90) 14) 0))))))
       (quake:set-field! actor buddy-trace-reason (if moving 1 2))))))

(define (uplink-buddy-arrive actor player waypoint)
  ; Regroup at a mapper-checked service landing after a short radio delay.
  (quake:set-field! actor buddy-trace-goal waypoint)
  (quake:set-field! actor buddy-trace-reason 3)
  (when (and (>= (quake:time) (quake:field actor buddy-regroup-time))
             (uplink-close? waypoint player 360 90)
             (not (uplink-close? actor waypoint 160 72))
             (not (occupied-start? waypoint (quake:world) (quake:world))))
    (quake:set-origin actor (quake:field waypoint origin))
    (quake:drop-to-floor)
    (quake:set-field! actor buddy-trace-reason 5)
    (quake:dprint "uplink: buddy arrived by service route\n")))

(define (uplink-buddy-shoot actor)
  (let ((guard (uplink-named "switch-guard")))
    (when (and (>= (quake:time) (quake:field actor buddy-shot))
               (uplink-close? actor guard 540 96) (sentry-visible? actor guard))
      (quake:set-field! actor angles_y (sentry-facing actor guard))
      (quake:set-field! actor buddy-shot (+ (quake:time) 0.42))
      (quake:sound actor 1 "weapons/spike2.wav" 0.65 1)
      (damage guard actor 8)
      (quake:dprint "uplink: buddy fired\n"))))

(define (uplink-buddy-yield actor cursor)
  (let ((rider (quake:find cursor classname "qslisp_player")))
    (and (not (quake:world? rider))
         (or (and (active-player? rider) (riding-bike? rider)
                  (uplink-close? actor rider 200 40)
                  (let* ((vx (quake:field rider bike-vx))
                         (vy (quake:field rider bike-vy))
                         (velocity (quake:vector vx vy 0))
                         (speed (quake:vector-length velocity))
                         (yaw (if (> speed 24) (quake:vector-yaw velocity)
                                  (quake:field rider bike-heading))))
                    (quake:make-vectors (quake:vector 0 yaw 0))
                    (let* ((dx (- (quake:field actor origin_x) (quake:field rider origin_x)))
                           (dy (- (quake:field actor origin_y) (quake:field rider origin_y)))
                           (ahead (+ (* dx (quake:forward-x)) (* dy (quake:forward-y))))
                           (side (- (* dy (quake:forward-x)) (* dx (quake:forward-y)))))
                      (and (or (> speed 24) (> (quake:field rider button0) 0))
                           (> ahead -20) (< ahead (+ 60 (* speed 0.29)))
                           (< (bike-abs side) 52)
                           (let ((turn (if (< side 0) -90 90)))
                             (when (or (> (quake:walkmove (+ yaw turn) 24) 0)
                                       (> (quake:walkmove (- yaw turn) 24) 0))
                               (quake:set-field! actor buddy-trace-reason 6))
                             #t)))))
             (uplink-buddy-yield actor rider)))))

(define (uplink-buddy-animation actor x y)
  (let* ((dx (- (quake:field actor origin_x) x))
         (dy (- (quake:field actor origin_y) y))
         (distance (+ (* dx dx) (* dy dy))))
    ; Repositioning through a service route should start in a stationary pose.
    (quake:set-field! actor frame
      (cond ((and (> distance 1) (< distance 900)) buddy-frame-walk)
            ((= (quake:field actor buddy-state) buddy-assist) buddy-frame-assist)
            (else buddy-frame-idle)))))

(define (uplink-buddy-think)
  (let* ((actor (quake:self))
         (player (quake:field actor buddy-leader))
         (state (quake:field actor buddy-state))
         (lift (uplink-standing-lift actor))
         (x (quake:field actor origin_x))
         (y (quake:field actor origin_y)))
    (quake:set-field! actor nextthink (+ (quake:time) 0.12))
    (when (= state buddy-wait)
      (quake:set-field! actor buddy-trace-reason 0)
      (quake:set-field! actor buddy-trace-goal (quake:world)))
    (when (and (= (quake:field lift lift-moving) 0)
               (not (uplink-buddy-yield actor (quake:world))) (active-player? player))
      (cond
        ((= state buddy-follow)
         (cond
           ((uplink-close? player (uplink-named "switch-guard") 485 90)
            (quake:set-field! actor buddy-state buddy-assist)
            (quake:set-field! actor buddy-goal (uplink-named "switch-cover")))
           ((uplink-close? actor player 950 90) (uplink-buddy-step actor player 88))
           (else (uplink-buddy-arrive actor player
                   (uplink-near-waypoint player (quake:world) (quake:world))))))
        ((= state buddy-regroup)
         (let ((spot (uplink-near-waypoint player (quake:world) (quake:world))))
           (if (uplink-close? actor player 950 90)
               (uplink-buddy-step actor player 66)
               (uplink-buddy-arrive actor player spot))
           (when (uplink-close? actor player 160 74)
             (quake:set-field! actor buddy-state buddy-follow))))
        ((= state buddy-assist)
         (let ((goal (quake:field actor buddy-goal)))
           (if (and (string=? (quake:field goal targetname) "switch-cover")
                    (quake:world? (uplink-named "switch-guard")))
               (uplink-buddy-order actor player buddy-follow)
               (let ((task (quake:field actor buddy-task)))
                 (when (not (uplink-close? actor player 950 90))
                   (uplink-buddy-arrive actor player (uplink-near-waypoint player (quake:world) (quake:world))))
                 (uplink-buddy-step actor goal 38)
                 (uplink-buddy-shoot actor)
                 (when (and (not (quake:world? task)) (uplink-close? actor goal 56 72))
                   (quake:set-field! actor buddy-task (quake:world))
                   (quake:dprint "uplink: buddy used a station\n")
                   (quake:call-callback task use player)
                   (uplink-buddy-order actor player buddy-follow))))))))
    (uplink-buddy-animation actor x y)))

;; "Buddy, use that": aim at a station with a buddy spot and press Q.
;; Interlisp's DWIM corrected what you typed into what it thought you meant;
;; every fourth order, the buddy does the same with the station you chose.
(define (station-spot station)
  (if (string=? (quake:field station buddy-spot) "") (quake:world) (uplink-named (quake:field station buddy-spot))))

(define (uplink-far-station player eye cursor best best-dot)
  (let ((station (quake:find cursor classname "uplink_station")))
    (if (quake:world? station)
        best
        (let ((spot (station-spot station)))
          (if (quake:world? spot)
              (uplink-far-station player eye station best best-dot)
              (let* ((dx (- (quake:field spot origin_x) (quake:vector-x eye)))
                     (dy (- (quake:field spot origin_y) (quake:vector-y eye)))
                     (distance (quake:vector-length (quake:vector dx dy 0)))
                     (dot (/ (+ (* dx (quake:forward-x)) (* dy (quake:forward-y))) (if (> distance 1) distance 1))))
                (if (and (> dot best-dot) (< distance 1500))
                    (uplink-far-station player eye station station dot)
                    (uplink-far-station player eye station best best-dot))))))))

(define (uplink-nearest-station aimed cursor best best-distance)
  (let ((station (quake:find cursor classname "uplink_station")))
    (if (quake:world? station)
        best
        (let ((spot (station-spot station)))
          (if (or (quake:world? spot) (quake:entity=? station aimed))
              (uplink-nearest-station aimed station best best-distance)
              (let ((distance (sentry-distance-squared spot (station-spot aimed))))
                (if (< distance best-distance)
                    (uplink-nearest-station aimed station station distance)
                    (uplink-nearest-station aimed station best best-distance))))))))

(define (uplink-buddy-task player buddy)
  (quake:make-vectors (quake:vector 0 (quake:field player v_angle_y) 0))
  (let ((aimed (uplink-far-station player (player-eye player) (quake:world) (quake:world) 0.99)))
    (if (quake:world? aimed)
        (quake:centerprint player "Aim at a station with a buddy spot, then press Q.")
        (let* ((count (+ 1 (quake:field buddy buddy-dwim)))
               (other (uplink-nearest-station aimed (quake:world) (quake:world) 99999999))
               (dwim (and (= count 4) (not (quake:world? other))))
               (station (if dwim other aimed)))
          (quake:set-field! buddy buddy-dwim (if (= count 4) 0 count))
          (uplink-buddy-order buddy player buddy-assist)
          (quake:set-field! buddy buddy-goal (station-spot station))
          (quake:set-field! buddy buddy-task station)
          (if dwim
              (begin
                (quake:centerprint player "Buddy: Do What I Mean.\nHeading for the station I think you meant.")
                (quake:dprint "uplink: buddy did what it thought you meant\n"))
              (quake:centerprint player "Buddy heading to that station."))))))

(define (uplink-buddy-commands player)
  (let ((command (quake:field player impulse)))
    (when (= command 20)
      (quake:set-field! player impulse 0)
      (let ((buddy (uplink-teammate)))
        (when (not (quake:world? buddy)) (uplink-buddy-task player buddy))))
    (when (and (>= command 21) (<= command 23))
      (quake:set-field! player impulse 0)
      (let ((buddy (uplink-teammate)))
        (when (not (quake:world? buddy))
          (cond
            ((= command 21)
             (uplink-buddy-order buddy player buddy-follow)
             (quake:centerprint player "Buddy following."))
            ((= command 22)
             (uplink-buddy-order buddy player buddy-wait)
             (quake:centerprint player "Buddy waiting."))
            (else
             (uplink-buddy-order buddy player buddy-regroup)
             (quake:centerprint player "Buddy regrouping."))))))))

(define (uplink_lift)
  (let ((lift (quake:self)))
    (quake:set-field! lift movetype move-push)
    (quake:set-field! lift solid solid-brush)
    (quake:set-model lift (quake:field lift model))))

(define (uplink-lift-stop)
  (let* ((lift (quake:self)) (end (quake:field lift lift-up)))
    (quake:set-field! lift velocity_z 0)
    (quake:set-origin lift (quake:vector 0 0 (* end (quake:field lift lift-travel))))
    (quake:set-field! lift lift-moving 0)
    (quake:dprint "uplink: lift arrived\n")))

(define (uplink-lift-start lift end)
  (let ((distance (- (* end (quake:field lift lift-travel)) (quake:field lift origin_z))))
    (quake:set-field! lift lift-up end)
    (quake:set-field! lift lift-moving 1)
    (quake:set-field! lift velocity_z (if (> distance 0) 320 -320))
    (quake:set-callback! lift think uplink-lift-stop)
    (quake:set-field! lift nextthink (+ (quake:field lift ltime) (/ (bike-abs distance) 320)))
    (quake:dprint "uplink: lift departing\n")))

(define (uplink-operate-lift lift landing aboard player)
  (cond
    ((= (quake:field lift lift-locked) 1)
     (quake:centerprint player "Lift has no power."))
    ((= (quake:field lift lift-moving) 1)
     (quake:centerprint player "Lift in transit."))
    ((not (= landing (quake:field lift lift-up)))
     (uplink-lift-start lift landing)
     (quake:centerprint player "Lift called."))
    (aboard (uplink-lift-start lift (- 1 landing)))
    (else (quake:centerprint player "Lift here. Board the platform and press E."))))

(define (uplink-standing-lift actor)
  (let ((ground (quake:field actor groundentity)))
    (if (and (> (quake:bit-and (quake:field actor flags) flag-ground) 0)
             (string=? (quake:field ground classname) "uplink_lift"))
        ground
        (quake:world))))

(define (uplink-lift-input player)
  (let ((lift (uplink-standing-lift player)))
    (and (not (quake:world? lift))
         (begin
           (if (and (< (bike-abs (- (quake:field player origin_x) (quake:field lift lift-x))) 232)
                    (< (bike-abs (- (quake:field player origin_y) (quake:field lift lift-y))) 232))
               (uplink-operate-lift lift (quake:field lift lift-up) #t player)
               (quake:centerprint player "Move fully onto the platform and press E."))
           #t))))

(define (uplink-ray-interval start delta low high)
  (if (< (bike-abs delta) 0.001)
      (if (and (>= start low) (<= start high)) (quake:vector 0 1 0) (quake:vector 2 -1 0))
      (let ((a (/ (- low start) delta)) (b (/ (- high start) delta)))
        (if (< a b) (quake:vector a b 0) (quake:vector b a 0)))))

(define (uplink-min a b)
  (if (< a b) a b))

(define (uplink-max a b)
  (if (> a b) a b))

(define (uplink-station-hit station eye ray limit)
  (let* ((x (uplink-ray-interval (quake:vector-x eye) (quake:vector-x ray)
                                 (quake:field station absmin_x) (quake:field station absmax_x)))
         (y (uplink-ray-interval (quake:vector-y eye) (quake:vector-y ray)
                                 (quake:field station absmin_y) (quake:field station absmax_y)))
         (z (uplink-ray-interval (quake:vector-z eye) (quake:vector-z ray)
                                 (quake:field station absmin_z) (quake:field station absmax_z)))
         (entry (uplink-max 0 (uplink-max (quake:vector-x x)
                                (uplink-max (quake:vector-x y) (quake:vector-x z)))))
         (exit (uplink-min limit (uplink-min (quake:vector-y x)
                                   (uplink-min (quake:vector-y y) (quake:vector-y z))))))
    (if (<= entry exit) entry limit)))

(define (uplink-station-near? station eye)
  (and (<= (- (quake:field station absmin_x) 96) (quake:vector-x eye))
       (>= (+ (quake:field station absmax_x) 96) (quake:vector-x eye))
       (<= (- (quake:field station absmin_y) 96) (quake:vector-y eye))
       (>= (+ (quake:field station absmax_y) 96) (quake:vector-y eye))
       (<= (- (quake:field station absmin_z) 96) (quake:vector-z eye))
       (>= (+ (quake:field station absmax_z) 96) (quake:vector-z eye))))

(define (uplink-find-station cursor eye ray limit best)
  (let ((station (quake:find cursor classname "uplink_station")))
    (if (quake:world? station)
        best
        (let ((entry (if (uplink-station-near? station eye)
                         (uplink-station-hit station eye ray limit) limit)))
          (if (< entry limit)
              (uplink-find-station station eye ray entry station)
              (uplink-find-station station eye ray limit best))))))

(define (uplink-aimed-station player)
  ; Only the Use ray hits the station panels. Walls and other solid targets
  ; still stop the ray, while the rider hull can pass the panels freely.
  (let* ((limit (quake:trace-fraction))
         (ray (quake:vector (* 96 (quake:forward-x)) (* 96 (quake:forward-y))
                            (* 96 (quake:forward-z)))))
    (uplink-find-station (quake:world) (player-eye player) ray limit (quake:world))))

(define (uplink_station)
  (let ((station (quake:self)))
    (quake:set-model station (quake:field station model))
    (quake:set-callback! station use uplink-use-station)))

(define (uplink-unlock station)
  (let ((lift (find-linked station)))
    (when (not (quake:world? lift))
      (quake:set-field! lift lift-locked 0)))
  (quake:set-field! station uplink-active 1)
  (quake:set-field! station effects 4))

(define (uplink-player-at-valve? station player cursor)
  (let ((other (quake:find cursor classname "qslisp_player")))
    (and (not (quake:world? other))
         (or (and (not (quake:entity=? player other)) (active-player? other)
                  (uplink-close? station other 90 64))
             (uplink-player-at-valve? station player other)))))

(define (uplink-use-station)
  (let* ((station (quake:self)) (player (quake:other))
         (name (quake:field station targetname)) (buddy (uplink-teammate)))
    (when (active-player? player)
      (cond
        ((> (quake:field station lift-call-stop) 0)
         (let ((lift (find-linked station)))
           (when (not (quake:world? lift))
             (quake:dprint "uplink: lift call button pressed\n")
             (uplink-operate-lift lift (- (quake:field station lift-call-stop) 1) #f player))))
        ((string=? name "hold-pump")
         (when (not (quake:world? buddy))
           (uplink-buddy-order buddy player buddy-assist)
           (quake:set-field! buddy buddy-goal (uplink-named "pump-hold"))
           (quake:centerprint player "Buddy heading to the valve. Use the pump breaker once they arrive.")))
        ((string=? name "pump-breaker")
         (let ((valve (uplink-named "pump-hold")))
           (if (or (= (quake:field station uplink-active) 1)
                   (uplink-close? valve buddy 88 68)
                   (uplink-player-at-valve? valve player (quake:world)))
               (begin
                 (uplink-unlock station)
                 (uplink-record! 2 player)
                 (when (and (not (quake:world? buddy))
                            (quake:entity=? valve (quake:field buddy buddy-goal)))
                   (uplink-buddy-order buddy player buddy-follow))
                 (quake:centerprint player "Pumps online. Cargo lift powered.")
                 (quake:dprint "uplink: pumps online\n"))
               (quake:centerprint player "Someone must hold the valve station."))))
        ((string=? name "switch-breaker")
         (if (quake:world? (uplink-named "switch-guard"))
             (begin
               (uplink-unlock station)
               (uplink-record! 4 player)
               (quake:centerprint player "Switchgear online. Ride through both upper relays.")
               (quake:dprint "uplink: switchgear online\n"))
             (begin
               (when (not (quake:world? buddy))
                 (uplink-buddy-order buddy player buddy-assist)
                 (quake:set-field! buddy buddy-goal (uplink-named "switch-cover")))
               (quake:centerprint player "Clear the sentry. Buddy moving to cover."))))
        ((> (quake:field station probe-relay) 0) (uplink-release-relay station player))
        ((string=? name "roof-extract")
         (cond
           ((= (quake:field station uplink-active) 1)
            (quake:dprint "uplink: leaving for the Lambda Lab\n")
            (quake:change-level "lambda"))
           ((= (quake:bit-and (uplink-log-flags (read-uplink-log (uplink-named "mission-journal"))) 95) 95)
            (uplink-record! 32 player)
            (quake:set-field! station uplink-active 1)
            (quake:centerprint player "Uplink restored. Relay Annex complete.\nPress E again to leave for the Lambda Lab.")
            (quake:dprint "uplink: mission complete\n"))
           ((= (quake:bit-and (uplink-log-flags (read-uplink-log (uplink-named "mission-journal"))) 31) 31)
            (quake:centerprint player "The probe is deadlocked. Release one of its relays."))
           (else (quake:centerprint player "Both gantry relays must be online."))))
        (else
         (uplink-unlock station)
         (uplink-record! 1 player)
         (quake:centerprint player "Valve open. Sump lift powered.")
         (quake:dprint "uplink: flood valve opened\n"))))))

(define (uplink_relay)
  (let ((relay (quake:self)))
    (quake:set-field! relay solid solid-trigger)
    (quake:set-model relay (quake:field relay model))
    (quake:set-field! relay modelindex 0)
    (quake:set-callback! relay touch uplink-touch-relay)))

(define (uplink-touch-relay)
  (let ((relay (quake:self)) (player (quake:other)))
    (when (and (active-player? player) (riding-bike? player) (= (quake:field relay uplink-active) 0))
      (quake:set-field! relay uplink-active 1)
      (uplink-record! (if (string=? (quake:field relay targetname) "east-relay") 8 16) player)
      (quake:sound player 2 "misc/medkey.wav" 1 1)
      (quake:dprint "uplink: gantry relay online\n")
      (if (and (= (quake:field (uplink-named "east-relay") uplink-active) 1)
               (= (quake:field (uplink-named "west-relay") uplink-active) 1))
          (begin
            (quake:set-field! (uplink-named "roof-lift") lift-locked 0)
            (quake:centerprint player "Both relays online. Roof lift powered."))
          (if (string=? (quake:field relay targetname) "east-relay")
              (quake:centerprint player "East relay online (1/2). Ride west to the second.")
              (quake:centerprint player "West relay online (1/2). Ride east to the second."))))))

(define (uplink_recall)
  (let ((bay (quake:self)))
    (quake:precache-model "progs/g_nail.mdl")
    (quake:set-model bay "progs/g_nail.mdl")
    (quake:set-field! bay solid 2)
    (quake:set-size bay (quake:vector -16 -16 -24) (quake:vector 16 16 28))
    (quake:set-callback! bay use uplink-recall-bike)))

(define (uplink-free-bike player cursor fallback)
  (let* ((bike (quake:find cursor classname "qslisp_bike"))
         (last (quake:field bike bike-last-rider)))
    (cond
      ((quake:world? bike) fallback)
      ((not (quake:world? (quake:field bike bike-rider))) (uplink-free-bike player bike fallback))
      ((quake:entity=? player last) bike)
      (else (uplink-free-bike player bike (if (active-player? last) fallback bike))))))

(define (uplink-return-position bay bike offset)
  (let ((x (- (quake:field bay origin_x) 72))
        (y (+ (quake:field bay origin_y) offset))
        (z (+ (quake:field bay origin_z) 1)))
    (quake:traceline (quake:vector (- x 28) y z) (quake:vector (+ x 28) y z) 0 bike)
    (when (= (quake:trace-fraction) 1)
      (quake:traceline (quake:vector x (- y 28) z) (quake:vector x (+ y 28) z) 0 bike)
      (when (= (quake:trace-fraction) 1) (quake:vector x y z)))))

(define (uplink-recall-bike)
  (let* ((bay (quake:self)) (player (quake:other))
         (bike (uplink-free-bike player (quake:world) (quake:world))))
    (when (active-player? player)
      (if (quake:world? bike)
          (quake:centerprint player "No bike available to recover.")
          (let ((return-at (or (uplink-return-position bay bike 0)
                               (uplink-return-position bay bike -64)
                               (uplink-return-position bay bike 64))))
            (if return-at
                (begin
                  (quake:set-origin bike return-at)
                  (park-bike bike)
                  (quake:centerprint player "Bike returned to the service bay.")
                  (quake:dprint "uplink: bike recalled\n"))
                (quake:centerprint player "Clear the return area first.")))))))

;; Remote Agent: Deep Space 1's Lisp was debugged live from 100 million miles.
;; The probe's two relays each wait for the other's acknowledgement. Release
;; either one at its station, or send the buddy, so it fires first; the other
;; then acknowledges and the probe answers.
(define (uplink-release-relay station player)
  (let ((journal (uplink-log-flags (read-uplink-log (uplink-named "mission-journal")))))
    (cond
      ((not (= (quake:bit-and journal 31) 31)) (quake:centerprint player "The probe relays have no power yet."))
      ((> (quake:bit-and journal 64) 0) (quake:centerprint player "The probe is already answering."))
      (else
       (quake:set-field! station uplink-active 1)
       (quake:set-field! station effects 4)
       (uplink-record! 64 player)
       (quake:sound player 2 "misc/medkey.wav" 1 1)
       (quake:bprint "Relay released. It fires first; its partner acknowledges. The probe answers.\n")
       (quake:centerprint player "Deadlock broken. Remote Agent restored.\nUse the extraction panel.")
       (quake:dprint "uplink: probe online\n")))))
