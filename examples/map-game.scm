; Explore stock Quake and play the original Signal Room challenge.
(import "../qslisp/actors.scm" "../qslisp/persistence.scm" "sentry.scm" "progression.scm"
        "weapons.scm" "bike.scm" "uplink.scm" "uplink-tools.scm" "playtest-trace.scm" "lambda.scm")

(define-field gate-open)
(define-field linked-gate entity)
(define-field room-complete)
; The stock entity parser exposes the authored light key under this name.
(define-field light_lev)
(define move-walk 3)
(define move-push 7)
(define solid-trigger 1)
(define solid-slidebox 3)
(define solid-brush 4)
(define flag-client 8)
(define flag-ground 512)
(define flag-jump-ready 4096)

(define (worldspawn)
  (quake:precache-model "progs/player.mdl")
  (precache-weapons)
  (lambda-precache)
  (spawn-stats)
  (quake:precache-sound "weapons/pkup.wav")
  (quake:precache-sound "items/health1.wav")
  (quake:precache-sound "misc/medkey.wav")
  (quake:dprint "qslisp: worldspawn\n"))

(define (StartFrame)
  ; Record the startup frames without flooding the console during play.
  (if (< (quake:time) 1.4)
      (quake:dprint "qslisp: StartFrame\n")
      0))

; The loadout travels between levels in the stock spawn parms. A dead
; player leaves with the starting loadout, as in id's progs.
(define-field rune-order)
(define (starting-loadout) (list shell-weapon 100 3 0 0 0 shell-weapon 0 0))
(define (SetNewParms) (carry! (starting-loadout)))
(define (SetChangeParms)
  (let ((player (quake:self)))
    (carry! (if (<= (quake:field player health) 0)
                (starting-loadout)
                (list (quake:bit-and (quake:field player items) 127) (quake:field player health)
                      (quake:field player ammo_shells) (quake:field player ammo_nails)
                      (quake:field player ammo_rockets) (quake:field player ammo_cells)
                      (quake:field player weapon) (quake:field player tether-owned)
                      (quake:field player rune-order))))))

(define (restore-loadout player loadout)
  (match loadout
    ((list items health shells nails rockets cells weapon tether runes)
     (quake:set-field! player items (quake:bit-or items shell-weapon))
     (quake:set-field! player health health)
     (quake:set-field! player ammo_shells shells)
     (quake:set-field! player ammo_nails nails)
     (quake:set-field! player ammo_rockets rockets)
     (quake:set-field! player ammo_cells cells)
     (quake:set-field! player tether-owned tether)
     (quake:set-field! player rune-order runes)
     (equip player weapon))
    (_ (restore-loadout player (starting-loadout)))))
(define (ClientDisconnect)
  (let ((player (quake:self)))
    (return-bike player)
    (clear-tether player)
    (quake:set-field! player classname "")
    (quake:set-field! player health 0)
    (quake:set-field! player solid 0)
    (quake:set-field! player movetype 0)
    (quake:set-field! player modelindex 0)
    (quake:set-origin player (quake:field player origin))))
(define (ClientKill)
  (let ((player (quake:self)))
    (damage player (quake:world) (quake:field player health))))
(define (info_player_start) 0)
(define (info_player_coop) 0)
; As in id's progs, only switchable lights stay; the rest are baked and
; would only use up edicts.
(define (light)
  (when (string=? (quake:field (quake:self) targetname) "")
    (quake:remove (quake:self))))

(define (qslisp_target)
  (let ((plate (quake:self)))
    (quake:set-field! plate movetype move-push)
    (quake:set-field! plate solid solid-brush)
    (quake:set-model plate (quake:field plate model))
    (quake:set-callback! plate use finish-challenge)))

(define (qslisp_gate)
  (let ((gate (quake:self)))
    (quake:set-field! gate movetype move-push)
    (quake:set-field! gate solid solid-brush)
    (quake:set-model gate (quake:field gate model))
    (quake:set-callback! gate use open-gate)))

(define-sequence
  (step open-gate
    (let ((gate (quake:self)))
      (when (= (quake:field gate gate-open) 0)
        (quake:set-field! gate gate-open 1)
        (quake:set-field! gate effects 8)
        (after 0.12 lift-gate))))
  (step lift-gate
    (quake:set-field! (quake:self) velocity_z 400)
    (after 0.4 stop-gate))
  (step stop-gate
    (let ((gate (quake:self)))
      (quake:set-field! gate effects 0)
      (quake:set-field! gate velocity_z 0)
      (quake:set-field! gate solid 0)
      (quake:set-field! gate gate-open 2)
      (quake:set-origin gate (quake:field gate origin))
      (quake:dprint "qslisp: gate open\n"))))

(define (qslisp_exit)
  (let ((exit (quake:self)))
    (quake:set-field! exit solid solid-trigger)
    (quake:set-model exit (quake:field exit model))
    (quake:set-field! exit modelindex 0)
    (quake:set-callback! exit touch touch-exit)))

(define (find-linked entity)
  (quake:find (quake:world) targetname (quake:field entity target)))

(define (touch-exit)
  (let ((exit (quake:self)) (player (quake:other)))
    (when (and (active-player? player) (string=? (quake:field player next-level) ""))
      (when (quake:world? (quake:field exit linked-gate))
        (quake:set-field! exit linked-gate (find-linked exit)))
      (let ((gate (quake:field exit linked-gate)))
        (when (and (not (quake:world? gate)) (= (quake:field gate gate-open) 2))
          (quake:set-field! player movetype 0)
          (quake:set-field! player next-level (quake:field exit message))
          (quake:set-field! player velocity (quake:vector 0 0 0))
          (quake:centerprint player "Signal Room complete!\n\nE: continue   R: reset")
          (when (= (quake:field exit room-complete) 0)
            (quake:set-field! exit room-complete 1)
            (quake:dprint "qslisp: level complete\n")))))))

(define (ClientConnect)
  (quake:dprint "qslisp: ClientConnect\n"))

(define (update-jump player)
  (let* ((flags (quake:field player flags))
         (ready (quake:bit-and flags flag-jump-ready)))
    (cond ((= (quake:field player button2) 0)
           (when (= ready 0)
             (quake:set-field! player flags (quake:bit-or flags flag-jump-ready))))
          ((= ready 0) 0)
          (else
            (let ((remaining (- flags ready)))
              (if (= (quake:bit-and flags flag-ground) 0)
                  (quake:set-field! player flags remaining)
                  (begin
                    (quake:set-field! player flags (- remaining flag-ground))
                    (quake:set-field! player velocity_z 270)
                    (quake:dprint "qslisp: jump\n"))))))))

(define (finish-challenge)
  (let* ((plate (quake:self)) (player (quake:other)) (gate (find-linked plate)))
    (when (not (quake:world? gate))
      (quake:call-callback gate use player))
    (quake:remove plate)
    (quake:sound player 2 "misc/medkey.wav" 1 1)
    (quake:centerprint player "Signal restored!\n\nProceed through the gate.")
    (quake:dprint "qslisp: target hit\n")))

(define (player-eye player)
  (quake:vector (quake:field player origin_x) (quake:field player origin_y)
                (+ (quake:field player origin_z) (quake:field player view_ofs_z))))

; Inline this in each stock entry point to keep the pre-think frame profiled.
; Steering is a target yaw for a scripted rider, or #f for client input.
(define-syntax player-prethink
  (syntax-rules ()
    ((player-prethink subject steering)
     (let* ((player subject) (was-riding (riding-bike? player)))
       (if (<= (quake:field player health) 0)
           (update-respawn player)
           (begin
             (trace-command player)
             (uplink-buddy-commands player)
             (tether-input player)
             (actor-restart-input player)
             (tunables-input player)
             (follow-pending-pad player)
             (interact player)
             (cond
               ((riding-bike? player)
                (clear-tether player)
                (quake:set-field! player tether-held 0)
                (ride-bike player steering))
               ((and (not was-riding) (= (quake:field player movetype) move-walk))
                (select-weapon player)
                (update-tether player)
                (update-jump player)
                (update-weapon player)))))))))

(define (PlayerPostThink)
  (let* ((player (quake:self)) (riding (riding-bike? player)))
    (bike-sync-arrows player riding)
    (when (not riding) (ice-step player))
    (when riding
      (bike-bank-step player)
      (quake:set-field! player bike-vx (quake:field player velocity_x))
      (quake:set-field! player bike-vy (quake:field player velocity_y))
      (bike-surface-pose player)
      (bike-tire-effects player)
      (bike-chase-view player)
      ; Stock clients derive walking bob and view roll from this packet's
      ; horizontal velocity. The next bike tick uses its own momentum fields.
      (quake:set-field! player velocity_x 0)
      (quake:set-field! player velocity_y 0))
    (sample-gameplay player riding)))

(define (PutClientInServer)
  (let* ((player (quake:self)) (spot (spawn-point player)))
    (if (quake:world? spot)
        (quake:error "qslisp: map has no info_player_start\n")
        (begin
          (quake:set-field! player deadflag 0)
          (quake:set-field! player armorvalue 0)
          (quake:set-field! player takedamage 2)
          (quake:set-field! player classname "qslisp_player")
          (quake:set-field! player velocity (quake:vector 0 0 0))
          (quake:set-field! player punchangle (quake:vector 0 0 0))
          (quake:set-field! player next-shot (+ (quake:time) 0.35))
          (quake:set-field! player weaponframe 0)
          (quake:set-field! player movetype move-walk)
          (quake:set-field! player solid solid-slidebox)
          (quake:set-field! player flags flag-client)
          (quake:set-field! player fixangle 1)
          (drop-beacon player)
          (clear-marks player #f)
          (quake:set-field! player link-source (quake:world))
          (quake:set-field! player weapon 0)
          ; Respawns run outside Host_Spawn_f, so reload this client's parms first.
          (quake:set-spawn-parms player)
          (restore-loadout player (carried))
          (quake:set-field! player angles (quake:field spot angles))
          (quake:set-field! player view_ofs (quake:vector 0 0 22))
          (quake:set-model player "progs/player.mdl")
          (quake:set-size player (quake:vector -16 -16 -24) (quake:vector 16 16 32))
          (quake:set-origin player (quake:vector (quake:field spot origin_x)
                                                (quake:field spot origin_y)
                                                (+ (quake:field spot origin_z) 1)))
          (uplink-checkpoint-recovery player)
          (publish-scoreboard)
          (when (string=? (quake:field spot classname) "info_player_coop")
            (quake:dprint "qslisp: player spawned at co-op start\n"))
          (quake:dprint "qslisp: player spawned\n")))))
