; Seven stock HUD weapon slots. Keys 1-7 send impulses 1-7 for the matching slot.
; The shotgun, pulse carbine, linker, continuation beacon, tail-call ricochet,
; and mark-and-sweep share one firing loop. Slot 4 stays empty: the tether is
; on Mouse2 (uplink-tools.scm).
(define-field next-shot)
(define-field fire-held)
(define-field link-source entity)
(define-field link-next entity)
(define-field beacon entity)
(define-field beacon-yaw)
(define-field beacon-pitch)
(define-field mark-0 entity)
(define-field mark-1 entity)
(define-field mark-2 entity)
(define-field mark-3 entity)
(define-field mark-next)
(define-field bolt-bounces)
(define-field bolt-expires)

(define shell-weapon 1)
(define linker-weapon 2)
(define pulse-weapon 4)
(define beacon-weapon 16)
(define ricochet-weapon 32)
(define sweep-weapon 64)
(define shell-ammo-icon 256)
(define pulse-ammo-icon 512)
(define rocket-ammo-icon 1024)
(define cell-ammo-icon 2048)
(define ammo-icon-mask 3840)
; The stock client tints the view blue and shows the quad icon for this bit.
(define continuation-item 4194304)
(define move-toss 6)
(define move-noclip 8)

(define (precache-weapons)
  ; Generated view models and projectiles (examples/models).
  (quake:precache-model "progs/v_lshot.mdl")
  (quake:precache-model "progs/v_link.mdl")
  (quake:precache-model "progs/v_pulse.mdl")
  (quake:precache-model "progs/v_beacn.mdl")
  (quake:precache-model "progs/v_rico.mdl")
  (quake:precache-model "progs/v_sweep.mdl")
  (quake:precache-model "progs/beacon.mdl")
  (quake:precache-model "progs/bolt.mdl")
  (quake:precache-sound "weapons/sgun1.wav")
  (quake:precache-sound "weapons/spike2.wav")
  (quake:precache-sound "weapons/lstart.wav")
  (quake:precache-sound "weapons/lhit.wav")
  (quake:precache-sound "weapons/lock4.wav")
  (quake:precache-sound "weapons/grenade.wav")
  (quake:precache-sound "weapons/ric1.wav")
  (quake:precache-sound "weapons/rocket1i.wav")
  (quake:precache-sound "misc/r_tele1.wav"))

(define (weapon-for-slot slot)
  (cond ((= slot 1) shell-weapon) ((= slot 2) linker-weapon) ((= slot 3) pulse-weapon)
        ((= slot 5) beacon-weapon) ((= slot 6) ricochet-weapon) ((= slot 7) sweep-weapon)
        (else 0)))

(define (pulse-equipped? player)
  (= (quake:field player weapon) pulse-weapon))

(define (weapon-ammo player)
  (let ((weapon (quake:field player weapon)))
    (cond
      ((= weapon pulse-weapon) (quake:field player ammo_nails))
      ((= weapon ricochet-weapon) (quake:field player ammo_rockets))
      ((= weapon sweep-weapon) (quake:field player ammo_cells))
      ((= weapon beacon-weapon) (if (quake:world? (quake:field player beacon)) 1 0))
      ((= weapon linker-weapon) 0)
      (else (quake:field player ammo_shells)))))

(define (update-ammo player rounds)
  (let ((weapon (quake:field player weapon)))
    (cond
      ((= weapon pulse-weapon) (quake:set-field! player ammo_nails rounds))
      ((= weapon ricochet-weapon) (quake:set-field! player ammo_rockets rounds))
      ((= weapon sweep-weapon) (quake:set-field! player ammo_cells rounds))
      ((= weapon shell-weapon) (quake:set-field! player ammo_shells rounds))))
  (quake:set-field! player currentammo (weapon-ammo player)))

(define (refresh-ammo player)
  (quake:set-field! player currentammo (weapon-ammo player)))

(define (weapon-ammo-icon weapon)
  (cond ((= weapon pulse-weapon) pulse-ammo-icon) ((= weapon ricochet-weapon) rocket-ammo-icon)
        ((= weapon sweep-weapon) cell-ammo-icon) ((= weapon shell-weapon) shell-ammo-icon)
        (else 0)))

(define (weapon-view-model player weapon)
  (quake:set-field! player weaponmodel
    (cond ((= weapon linker-weapon) "progs/v_link.mdl")
          ((= weapon pulse-weapon) "progs/v_pulse.mdl")
          ((= weapon beacon-weapon) "progs/v_beacn.mdl")
          ((= weapon ricochet-weapon) "progs/v_rico.mdl")
          ((= weapon sweep-weapon) "progs/v_sweep.mdl")
          (else "progs/v_lshot.mdl"))))

(define (equip player weapon)
  (let ((items (quake:field player items)))
    (when (and (> weapon 0) (= (quake:bit-and items weapon) weapon))
      (when (not (= weapon (quake:field player weapon)))
        (clear-marks player #f)
        (quake:set-field! player link-source (quake:world)))
      (quake:set-field! player items
        (quake:bit-or (- items (quake:bit-and items ammo-icon-mask)) (weapon-ammo-icon weapon)))
      (quake:set-field! player weapon weapon)
      (weapon-view-model player weapon)
      (quake:set-field! player weaponframe 0)
      (refresh-ammo player))))

(define (select-weapon player)
  (let* ((command (quake:field player impulse)))
    (when (and (>= command 1) (<= command 7))
      (quake:set-field! player impulse 0)
      (equip player (weapon-for-slot command)))))

(define (give-weapon player weapon)
  (quake:set-field! player items (quake:bit-or (quake:field player items) weapon)))

(define (aim-end player range)
  (let ((eye (player-eye player)))
    (quake:vector (+ (quake:vector-x eye) (* range (quake:forward-x)))
                  (+ (quake:vector-y eye) (* range (quake:forward-y)))
                  (+ (quake:vector-z eye) (* range (quake:forward-z))))))

(define (aimed-entity player range)
  (quake:make-vectors (quake:field player v_angle))
  (quake:traceline (player-eye player) (aim-end player range) 0 player))

(define (trace-end)
  (quake:vector (quake:trace-end-x) (quake:trace-end-y) (quake:trace-end-z)))

(define (hostile? player target)
  (and (> (quake:field target takedamage) 0) (> (quake:field target health) 0)
       (not (quake:entity=? target player))
       (or (= (quake:coop) 0) (not (player-entity? target)))))

; Shotgun and pulse carbine: hitscan while fire is held.
(define (fire-hitscan player rounds)
  (update-ammo player (- rounds 1))
  (quake:set-field! player weaponframe 1)
  (quake:set-field! player punchangle_x -2)
  (if (pulse-equipped? player)
      (quake:sound player 1 "weapons/spike2.wav" 1 1)
      (quake:sound player 1 "weapons/sgun1.wav" 1 1))
  (quake:dprint "qslisp: fired\n")
  (let ((hit (aimed-entity player 800)))
    (when (not (quake:world? hit))
      (cond ((> (quake:field hit takedamage) 0)
             (when (pulse-equipped? player) (uplink-pulse-contact player hit))
             (damage hit player (if (pulse-equipped? player) 15 25)))
            ((string=? (quake:field hit classname) "qslisp_target")
             (quake:call-callback hit use player))
            ((pulse-equipped? player) (uplink-pulse-contact player hit))
            (else (lambda-shot-contact player hit))))))

; Linker: the first shot picks a source, the second makes it point at the target.
(define (linkable? entity)
  (or (string=? (quake:field entity classname) "lambda_pad")
      (string=? (quake:field entity classname) "lambda_conduit")
      (= (quake:bit-and (quake:field entity flags) flag-monster) flag-monster)))

(define (entity-center entity)
  (quake:vector (* 0.5 (+ (quake:field entity absmin_x) (quake:field entity absmax_x)))
                (* 0.5 (+ (quake:field entity absmin_y) (quake:field entity absmax_y)))
                (* 0.5 (+ (quake:field entity absmin_z) (quake:field entity absmax_z)))))

; Within 3 degrees of the aim, take the best-aligned visible entity of a class.
; Stock clients send view angles in 1.4-degree steps, so distant pads need it.
(define (assist-target player eye class cursor best best-dot)
  (let ((candidate (quake:find cursor classname class)))
    (if (quake:world? candidate)
        best
        (let* ((center (entity-center candidate))
               (dx (- (quake:vector-x center) (quake:vector-x eye)))
               (dy (- (quake:vector-y center) (quake:vector-y eye)))
               (dz (- (quake:vector-z center) (quake:vector-z eye)))
               (distance (quake:vector-length (quake:vector dx dy dz)))
               (dot (/ (+ (* dx (quake:forward-x)) (* dy (quake:forward-y)) (* dz (quake:forward-z)))
                       (if (> distance 1) distance 1))))
          (if (and (> dot best-dot) (< distance 1600)
                   (quake:entity=? candidate (quake:traceline eye center 0 player)))
              (assist-target player eye class candidate candidate dot)
              (assist-target player eye class candidate best best-dot))))))

(define (link-aim player)
  (let ((hit (aimed-entity player 1600)))
    (if (linkable? hit)
        hit
        (let* ((eye (player-eye player))
               (pad (assist-target player eye "lambda_pad" (quake:world) (quake:world) 0.9986)))
          (if (quake:world? pad)
              (assist-target player eye "lambda_conduit" (quake:world) hit 0.9986)
              pad)))))

(define (fire-linker player)
  (let* ((hit (link-aim player)) (source (quake:field player link-source))
         (point (trace-end)))
    (quake:set-field! player weaponframe 1)
    (quake:sound player 1 "weapons/lock4.wav" 1 1)
    (if (quake:world? source)
        (if (linkable? hit)
            (begin
              (quake:set-field! player link-source hit)
              (quake:beam player (quake:field player origin) (quake:field hit origin))
              (quake:centerprint player "Linker: source set. Fire at the target.")
              (quake:dprint "weapon: link source\n"))
            (quake:centerprint player "Linker: nothing to link there."))
        (begin
          (quake:set-field! player link-source (quake:world))
          (quake:beam player (quake:field source origin) point)
          (link! player source hit)))))

(define (link! player source target)
  (cond
    ((string=? (quake:field source classname) "lambda_pad")
     (lambda-relink player source target))
    ((string=? (quake:field source classname) "lambda_conduit")
     (if (string=? (quake:field target classname) "lambda_conduit")
         (begin
           (quake:set-field! source link-next target)
           (quake:centerprint player "Conduit linked. The collector can now reach it.")
           (quake:dprint "weapon: conduit linked\n"))
         (begin
           (quake:set-field! source link-next (quake:world))
           (quake:centerprint player "Conduit link cleared."))))
    ((string=? (quake:field target classname) "lambda_coil")
     (quake:set-field! source link-next target)
     (quake:centerprint player "Linked to the coil.")
     (quake:dprint "weapon: hostile linked to coil\n"))
    (else
     (quake:set-field! source link-next (quake:world))
     (quake:centerprint player "Link cleared."))))

; Continuation beacon: throw it, then fire again to return there.
(define (fire-beacon player)
  (let ((beacon (quake:field player beacon)))
    (if (quake:world? beacon)
        (throw-beacon player)
        (resume-beacon player beacon))))

(define (throw-beacon player)
  (let ((beacon (quake:spawn)) (origin (quake:field player origin)))
    (quake:make-vectors (quake:field player v_angle))
    (quake:set-field! beacon classname "lambda_beacon")
    (quake:set-field! beacon owner player)
    (quake:set-field! beacon movetype move-toss)
    (quake:set-field! beacon solid 0)
    (quake:set-model beacon "progs/beacon.mdl")
    ; The player's hull size makes stock toss physics clip it like the player.
    (quake:set-size beacon (quake:vector -16 -16 -24) (quake:vector 16 16 32))
    (quake:set-origin beacon origin)
    (quake:set-field! beacon velocity (quake:vector (* 520 (quake:forward-x)) (* 520 (quake:forward-y))
                                                   (+ 180 (* 520 (quake:forward-z)))))
    (quake:set-field! beacon effects 4)
    (quake:set-field! beacon beacon-yaw (quake:field player v_angle_y))
    (quake:set-field! beacon beacon-pitch (quake:field player v_angle_x))
    (quake:set-field! beacon bolt-expires (+ (quake:time) 30))
    (quake:set-callback! beacon think beacon-think)
    (quake:set-field! beacon nextthink (+ (quake:time) 0.5))
    (quake:set-field! player beacon beacon)
    (quake:set-field! player items (quake:bit-or (quake:field player items) continuation-item))
    (quake:sound player 1 "weapons/grenade.wav" 1 1)
    (refresh-ammo player)
    (quake:dprint "weapon: continuation captured\n")))

(define (beacon-think)
  (let* ((beacon (quake:self)) (contents (quake:point-contents (quake:field beacon origin))))
    (if (or (< contents -3) (> (quake:time) (quake:field beacon bolt-expires)))
        (let ((player (quake:field beacon owner)))
          (drop-beacon player)
          (quake:centerprint player "Continuation lost."))
        (quake:set-field! beacon nextthink (+ (quake:time) 0.5)))))

(define (drop-beacon player)
  (let ((beacon (quake:field player beacon)))
    (when (not (quake:world? beacon))
      (quake:remove beacon)
      (quake:set-field! player beacon (quake:world))
      (let ((items (quake:field player items)))
        (quake:set-field! player items (- items (quake:bit-and items continuation-item))))
      (refresh-ammo player))))

(define (resume-beacon player beacon)
  (if (occupied-start? beacon player (quake:world))
      (quake:centerprint player "Continuation blocked.")
      (let ((from (quake:field player origin)) (to (quake:field beacon origin)))
        (return-bike player)
        (quake:point-effect teleport from)
        (quake:set-origin player to)
        (quake:set-field! player velocity (quake:vector 0 0 0))
        (quake:set-field! player angles (quake:vector 0 (quake:field beacon beacon-yaw) 0))
        (quake:set-view-angles! player (quake:field beacon beacon-pitch) (quake:field beacon beacon-yaw) 0)
        (quake:set-field! player flags (- (quake:field player flags)
                                          (quake:bit-and (quake:field player flags) flag-ground)))
        (quake:point-effect teleport to)
        (quake:sound player 1 "misc/r_tele1.wav" 1 1)
        (drop-beacon player)
        (quake:dprint "weapon: continuation resumed\n"))))

; Tail-call ricochet: one bolt that reflects off walls and reuses itself.
(define (fire-ricochet player rounds)
  (let ((bolt (quake:spawn)))
    (update-ammo player (- rounds 1))
    (quake:make-vectors (quake:field player v_angle))
    (quake:set-field! bolt classname "lambda_ricochet")
    (quake:set-field! bolt owner player)
    (quake:set-field! bolt movetype move-noclip)
    (quake:set-field! bolt solid 0)
    (quake:set-model bolt "progs/bolt.mdl")
    (quake:set-size bolt (quake:vector 0 0 0) (quake:vector 0 0 0))
    (quake:set-origin bolt (player-eye player))
    (quake:set-field! bolt velocity (quake:vector (* 900 (quake:forward-x)) (* 900 (quake:forward-y))
                                                 (* 900 (quake:forward-z))))
    (quake:set-field! bolt angles (quake:field player v_angle))
    (quake:set-field! bolt effects 4)
    (quake:set-field! bolt bolt-bounces 0)
    (quake:set-field! bolt bolt-expires (+ (quake:time) 3))
    (quake:set-callback! bolt think ricochet-think)
    (quake:set-field! bolt nextthink (+ (quake:time) 0.02))
    (quake:set-field! player weaponframe 1)
    (quake:sound player 1 "weapons/rocket1i.wav" 1 1)
    (quake:dprint "weapon: ricochet fired\n")))

(define (ricochet-think)
  (let* ((bolt (quake:self)) (origin (quake:field bolt origin))
         (vx (quake:field bolt velocity_x)) (vy (quake:field bolt velocity_y))
         (vz (quake:field bolt velocity_z))
         (hit (quake:traceline origin (quake:vector (+ (quake:vector-x origin) (* vx 0.06))
                                                    (+ (quake:vector-y origin) (* vy 0.06))
                                                    (+ (quake:vector-z origin) (* vz 0.06)))
                               0 (quake:field bolt owner))))
    (quake:set-field! bolt nextthink (+ (quake:time) 0.04))
    (cond
      ((> (quake:time) (quake:field bolt bolt-expires)) (quake:remove bolt))
      ((= (quake:trace-fraction) 1) #f)
      ((> (quake:field hit takedamage) 0)
       (let ((bounces (quake:field bolt bolt-bounces)))
         (quake:point-effect spike (trace-end))
         (damage hit (quake:field bolt owner) (+ (tunable 8 20) (* 15 bounces)))
         (quake:dprint "weapon: ricochet hit after ")
         (quake:dprint-number bounces)
         (quake:dprint " bounces\n")
         (quake:remove bolt)))
      ((>= (quake:field bolt bolt-bounces) 5)
       (quake:point-effect explosion (trace-end))
       (quake:remove bolt))
      (else (ricochet-bounce bolt hit vx vy vz)))))

(define (ricochet-bounce bolt hit vx vy vz)
  ; Reflect about the hit plane: v - 2(v.n)n. The bolt stays one entity.
  (let* ((nx (quake:trace-normal-x)) (ny (quake:trace-normal-y)) (nz (quake:trace-normal-z))
         (along (* 2 (+ (* vx nx) (* vy ny) (* vz nz))))
         (end (trace-end)))
    (quake:set-origin bolt (quake:vector (+ (quake:vector-x end) (* 2 nx)) (+ (quake:vector-y end) (* 2 ny))
                                        (+ (quake:vector-z end) (* 2 nz))))
    (quake:set-field! bolt velocity (quake:vector (- vx (* along nx)) (- vy (* along ny)) (- vz (* along nz))))
    (quake:set-field! bolt bolt-bounces (+ (quake:field bolt bolt-bounces) 1))
    (quake:point-effect gunshot end)
    (quake:dprint "weapon: ricochet bounced\n")
    (quake:sound bolt 1 "weapons/ric1.wav" 1 1)
    (lambda-shot-contact (quake:field bolt owner) hit)))

; Mark-and-sweep: hold fire to mark up to four targets, release to sweep them.
(define (marked? player target)
  (or (quake:entity=? target (quake:field player mark-0)) (quake:entity=? target (quake:field player mark-1))
      (quake:entity=? target (quake:field player mark-2)) (quake:entity=? target (quake:field player mark-3))))

(define (add-mark! player target)
  (cond ((quake:world? (quake:field player mark-0)) (quake:set-field! player mark-0 target) #t)
        ((quake:world? (quake:field player mark-1)) (quake:set-field! player mark-1 target) #t)
        ((quake:world? (quake:field player mark-2)) (quake:set-field! player mark-2 target) #t)
        ((quake:world? (quake:field player mark-3)) (quake:set-field! player mark-3 target) #t)
        (else #f)))

(define (mark-target player)
  (let ((hit (aimed-entity player 900)) (cells (quake:field player ammo_cells)))
    (when (and (hostile? player hit) (not (marked? player hit)) (> cells 0) (add-mark! player hit))
      (update-ammo player (- cells 1))
      (quake:set-field! player weaponframe 1)
      (quake:lightning player (player-eye player) (quake:field hit origin))
      (quake:sound player 1 "weapons/lstart.wav" 1 1)
      (quake:dprint "weapon: marked\n"))))

(define (sweep-one player target)
  (when (and (not (quake:world? target)) (> (quake:field target health) 0))
    (quake:lightning player (player-eye player) (quake:field target origin))
    (quake:point-effect tar-explosion (quake:field target origin))
    (damage target player (tunable 7 40))
    (quake:dprint "weapon: swept\n")))

(define (clear-marks player sweep)
  (when sweep
    (sweep-one player (quake:field player mark-0))
    (sweep-one player (quake:field player mark-1))
    (sweep-one player (quake:field player mark-2))
    (sweep-one player (quake:field player mark-3))
    (quake:sound player 1 "weapons/lhit.wav" 1 1))
  (quake:set-field! player mark-0 (quake:world))
  (quake:set-field! player mark-1 (quake:world))
  (quake:set-field! player mark-2 (quake:world))
  (quake:set-field! player mark-3 (quake:world)))

(define (any-marks? player)
  (not (and (quake:world? (quake:field player mark-0)) (quake:world? (quake:field player mark-1))
            (quake:world? (quake:field player mark-2)) (quake:world? (quake:field player mark-3)))))

(define (update-sweep player held now)
  (if held
      (when (>= now (quake:field player mark-next))
        (quake:set-field! player mark-next (+ now 0.25))
        (mark-target player))
      (when (any-marks? player) (clear-marks player #t))))

(define (update-weapon player)
  (let* ((now (quake:time)) (weapon (quake:field player weapon))
         (held (> (quake:field player button0) 0))
         (pressed (and held (= (quake:field player fire-held) 0))))
    (quake:set-field! player fire-held (if held 1 0))
    (cond
      ((= weapon sweep-weapon) (update-sweep player held now))
      ((< now (quake:field player next-shot)) #f)
      ((not held) (when (> (quake:field player weaponframe) 0) (quake:set-field! player weaponframe 0)))
      ((= weapon linker-weapon)
       (when pressed (quake:set-field! player next-shot (+ now 0.3)) (fire-linker player)))
      ((= weapon beacon-weapon)
       (when pressed (quake:set-field! player next-shot (+ now 0.4)) (fire-beacon player)))
      (else
       (let ((rounds (weapon-ammo player)))
         (quake:set-field! player next-shot
           (+ now (cond ((= weapon pulse-weapon) 0.2) ((= weapon ricochet-weapon) 0.8) (else 0.35))))
         (cond
           ((<= rounds 0) (quake:centerprint player "Out of ammo.\nPress R to reset."))
           ((= weapon ricochet-weapon) (fire-ricochet player rounds))
           (else (fire-hitscan player rounds))))))))
